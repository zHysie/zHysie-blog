---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { resolveRoute } from "../../i18n/routes";
import { getMarkdownExcerpt } from "../../lib/blog";
import type { Locale } from "../../lib/site-config";
import { Icon } from "../ui/index";

export interface Props {
  post: CollectionEntry<"blog">;
  locale?: Locale;
}

const { post, locale = post.data.locale } = Astro.props as Props;
const publishDate = new Date(post.data.publishDate);
const source = post.body ?? "";
const cjkCharacters = source.match(/[\u3400-\u9fff]/g)?.length ?? 0;
const latinWords = source.match(/[A-Za-z0-9]+/g)?.length ?? 0;
const readingTime = Math.max(
  1,
  Math.ceil(cjkCharacters / 500 + latinWords / 220),
);
const href = resolveRoute(locale, `/posts/${post.id}`);
const dateLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(publishDate);
const image = post.data.image;
const excerpt = getMarkdownExcerpt(source);
---

<article
  class:list={["post-archive-item", { "post-archive-item--media": image }]}
  data-post-item
  data-category={post.data.category}
  data-tags={JSON.stringify(post.data.tags ?? [])}
>
  <a class="post-archive-item__link" href={href}>
    <div class="post-archive-item__content">
      <h2 class="post-archive-item__title">{post.data.title}</h2>
      <p class="post-archive-item__excerpt">{excerpt}</p>
      <p class="post-archive-item__meta">
        <span class="post-archive-item__meta-group">
          <Icon name="lucide:calendar" size="0.875rem" decorative />
          <time datetime={publishDate.toISOString()}>{dateLabel}</time>
        </span>
        <span aria-hidden="true">·</span>
        <span class="post-archive-item__meta-group post-archive-item__category">
          <Icon name="lucide:folder" size="0.875rem" decorative />
          <span>{post.data.category}</span>
        </span>
        <span aria-hidden="true">·</span>
        <span
          class="post-archive-item__meta-group post-archive-item__reading-time"
        >
          <Icon name="lucide:clock" size="0.875rem" decorative />
          <span>{readingTime} min</span>
        </span>
      </p>
    </div>
    {
      image && (
        <figure class="post-archive-item__media">
          <Image
            src={image}
            alt={post.data.imageAlt ?? post.data.title}
            widths={[320, 480, 640]}
            sizes="(min-width: 640px) 18rem, calc(100vw - 2rem)"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
  </a>
</article>

<style>
  .post-archive-item {
    position: relative;
    margin-inline: calc(var(--space-md) * -1);
  }

  .post-archive-item__link {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    padding: var(--space-lg) var(--space-md);
    color: inherit;
    text-decoration: none;
  }

  .post-archive-item__link:focus-visible {
    border-radius: var(--radius-xs);
  }

  .post-archive-item__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .post-archive-item__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    color: var(--color-text-primary);
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-archive-item:hover .post-archive-item__title,
  .post-archive-item:focus-within .post-archive-item__title {
    color: var(--brand-logo-blue);
  }

  .post-archive-item__excerpt {
    display: -webkit-box;
    min-height: 3.25em;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-archive-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .post-archive-item__meta > :global(.post-archive-item__meta-group) {
    display: inline-flex;
    gap: var(--spacing-1);
    align-items: center;
    white-space: nowrap;
  }

  .post-archive-item__meta
    > :global(.post-archive-item__meta-group)
    > :global(svg) {
    flex: none;
    stroke-width: 1.5;
  }

  .post-archive-item__reading-time {
    font-style: italic;
  }

  .post-archive-item__category {
    font-family: var(--font-cjk-sans);
  }

  .post-archive-item__media {
    position: absolute;
    z-index: 0;
    inset: 0 0 auto;
    overflow: hidden;
    height: 9rem;
    margin: 0;
    border-radius: var(--radius-lg);
    -webkit-mask-image: linear-gradient(to top, transparent, black);
    mask-image: linear-gradient(to top, transparent, black);
  }

  .post-archive-item__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.58;
    transform: scale(1.015);
    transition:
      opacity 220ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .post-archive-item--media .post-archive-item__link {
    padding-top: calc(var(--space-3xl) + var(--space-lg));
  }

  .post-archive-item:hover .post-archive-item__media :global(img),
  .post-archive-item:focus-within .post-archive-item__media :global(img) {
    opacity: 0.76;
    transform: scale(1.04);
  }

  @media (width >= 40rem) {
    .post-archive-item__link {
      min-height: var(--spacing-11);
    }

    .post-archive-item--media .post-archive-item__link {
      padding-top: var(--space-lg);
    }

    .post-archive-item__media {
      inset: 0 0 0 auto;
      width: min(60%, 28rem);
      height: auto;
      -webkit-mask-image: linear-gradient(to right, transparent, black);
      mask-image: linear-gradient(to right, transparent, black);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-archive-item__title,
    .post-archive-item__media :global(img) {
      transition: none;
    }
  }
</style>
