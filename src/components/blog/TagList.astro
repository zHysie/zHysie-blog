---
import type { Locale } from "../../lib/site-config";
import { t } from "../../i18n/ui";

export interface Props {
  tags: string[];
  basePath?: string;
  locale?: Locale;
}

const { tags, basePath = "/posts", locale = "zh-CN" } = Astro.props as Props;
---

{
  tags.length > 0 && (
    <div class="blog-tags" aria-label={t(locale, "blog.tags")}>
      {tags.map((tag) => (
        <a
          class="blog-tags__tag"
          href={`${basePath}?tag=${encodeURIComponent(tag)}`}
        >
          <span class="blog-tags__tag-content">{tag}</span>
        </a>
      ))}
    </div>
  )
}

<style>
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-2);
    row-gap: var(--spacing-1);
  }

  .blog-tags__tag {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: var(--space-xl);
    padding: var(--spacing-1) var(--spacing-2) var(--spacing-1) var(--space-lg);
    overflow: hidden;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .blog-tags__tag::before,
  .blog-tags__tag::after {
    position: absolute;
    pointer-events: none;
    content: "";
  }

  .blog-tags__tag::before {
    z-index: 0;
    top: 50%;
    left: var(--spacing-1);
    width: var(--space-sm);
    height: calc(var(--spacing-1) / 2);
    border-radius: var(--radius-full);
    background: linear-gradient(
      90deg,
      var(--brand-logo-blue),
      var(--brand-logo-pink)
    );
    opacity: 0;
    transform: translate3d(calc(var(--spacing-1) * -1), -50%, 0) scaleX(0.45);
    transform-origin: left center;
    transition:
      opacity 150ms ease-out,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .blog-tags__tag::after {
    z-index: -1;
    inset: calc(var(--spacing-1) / 2) 0;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--brand-logo-blue) 10%, transparent);
    clip-path: polygon(0 18%, 92% 0, 100% 42%, 94% 86%, 6% 100%, 0 72%);
    opacity: 0;
    transform: scaleX(0.1);
    transform-origin: left center;
    transition:
      opacity 150ms ease-out,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 100ms ease-out;
  }

  .blog-tags__tag-content {
    position: relative;
    z-index: 1;
    transform: translate3d(0, 0, 0);
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .blog-tags__tag:hover,
  .blog-tags__tag:focus-visible {
    color: var(--color-text-primary);
  }

  .blog-tags__tag:hover::before,
  .blog-tags__tag:focus-visible::before {
    opacity: 1;
    transform: translate3d(0, -50%, 0) scaleX(1);
  }

  .blog-tags__tag:hover::after,
  .blog-tags__tag:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .blog-tags__tag:hover .blog-tags__tag-content,
  .blog-tags__tag:focus-visible .blog-tags__tag-content {
    transform: translate3d(calc(var(--spacing-1) / 2), 0, 0);
  }

  .blog-tags__tag:active {
    transform: scale(0.985);
  }

  .blog-tags__tag:active::after {
    background: color-mix(in oklab, var(--brand-logo-blue) 16%, transparent);
  }

  .blog-tags__tag:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-tags__tag,
    .blog-tags__tag::before,
    .blog-tags__tag::after,
    .blog-tags__tag-content {
      transition: none;
    }
  }
</style>
