---
import { type Locale } from "../../lib/site-config";
import { resolveRoute } from "../../i18n/routes";
import { Button, Icon } from "../ui/index";
import { heroVariantClasses, type HeroVariant } from "./hero.variants";

export interface Cta {
  label: string;
  href: string;
}

export interface Props {
  variant?: HeroVariant;
  size?: "sm" | "md" | "lg" | "xl";
  eyebrow?: string;
  headline?: string;
  title?: string;
  subheadline?: string;
  content?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  ctaText?: string;
  ctaHref?: string;
  locale?: Locale;
  extendBehindHeader?: boolean;
  fullViewport?: boolean;
  scrollTarget?: string;
  scrollLabel?: string;
  footerText?: string;
  animatedHeadlineText?: string;
  typewriterLoop?: boolean;
  scrollZoom?: boolean;
}

const props = Astro.props as Props;
const variant = props.variant ?? "centered";
const headline = props.headline ?? props.title ?? "";
const subheadline = props.subheadline ?? props.content;
const locale = props.locale ?? "en";
const primaryCta =
  props.primaryCta ??
  (props.ctaText && props.ctaHref
    ? { label: props.ctaText, href: props.ctaHref }
    : undefined);
const hasImageSlot = Astro.slots.has("image");
const hasEyebrowSlot = Astro.slots.has("eyebrow");
const animatedHeadlineText = props.animatedHeadlineText;
const hasAnimatedHeadline = Boolean(
  animatedHeadlineText && headline.endsWith(animatedHeadlineText),
);
const headlinePrefix = hasAnimatedHeadline
  ? headline.slice(0, -animatedHeadlineText!.length).trimEnd()
  : "";
---

<div
  class:list={[
    "hero-wrap",
    { "hero-wrap--behind-header": props.extendBehindHeader },
    { "hero-wrap--full": props.fullViewport },
    { "hero-wrap--scroll-zoom": props.scrollZoom },
  ]}
  data-hero-scroll-zoom={props.scrollZoom ? "" : undefined}
>
  <div class="hero__backdrop" aria-hidden="true">
    <span class="bg-grid"></span>
    <span class="bg-glow"></span>
  </div>
  <section class={`${heroVariantClasses[variant]} container`}>
    <div class="hero__content">
      {
        (props.eyebrow || hasEyebrowSlot) && (
          <p class="hero__eyebrow">
            {hasEyebrowSlot ? <slot name="eyebrow" /> : props.eyebrow}
          </p>
        )
      }
      {
        headline && (
          <h1 class={`hero__headline hero__headline--${props.size ?? "lg"}`}>
            {hasAnimatedHeadline ? (
              <>
                {headlinePrefix && (
                  <>
                    <span>{headlinePrefix}</span>{" "}
                  </>
                )}
                <span
                  class="hero__headline-typed"
                  aria-label={animatedHeadlineText}
                  data-hero-typewriter={animatedHeadlineText}
                  data-typewriter-loop={props.typewriterLoop ? "" : undefined}
                >
                  <span class="hero__headline-sizer" aria-hidden="true">
                    {animatedHeadlineText}
                  </span>
                  <span class="hero__headline-live" aria-hidden="true">
                    <span data-typewriter-output>{animatedHeadlineText}</span>
                    <span class="hero__headline-caret">|</span>
                  </span>
                </span>
              </>
            ) : (
              headline
            )}
          </h1>
        )
      }
      {subheadline && <p class="hero__subheadline">{subheadline}</p>}
      {
        (primaryCta || props.secondaryCta) && (
          <div class="hero__actions">
            {primaryCta && (
              <Button href={resolveRoute(locale, primaryCta.href)}>
                {primaryCta.label}
              </Button>
            )}
            {props.secondaryCta && (
              <Button
                href={resolveRoute(locale, props.secondaryCta.href)}
                variant="secondary"
              >
                {props.secondaryCta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>

    {
      (hasImageSlot || variant === "split") && (
        <div class="hero__media">
          <slot name="image" />
        </div>
      )
    }
  </section>

  {
    (props.footerText || props.scrollTarget) && (
      <div class="hero__footer">
        {props.footerText && <p>{props.footerText}</p>}
        {props.scrollTarget && (
          <a
            class="hero__scroll"
            href={`#${props.scrollTarget}`}
            aria-label={props.scrollLabel ?? "Scroll to the next section"}
          >
            {!props.footerText && (
              <span>{props.scrollLabel ?? "Scroll to explore"}</span>
            )}
            <Icon name="lucide:chevron-down" size="1.25rem" />
          </a>
        )}
      </div>
    )
  }
</div>

<style>
  @font-face {
    font-family: "Genshin HYWenHei 85W";
    src: url("../../../materials/fonts/希腊语纠正版原神汉仪文黑85W.ttf")
      format("truetype");
    font-weight: 850;
    font-style: normal;
    font-display: swap;
  }

  .hero-wrap {
    position: relative;
    isolation: isolate;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__backdrop :global(.bg-grid),
  .hero__backdrop :global(.bg-glow) {
    z-index: 0;
  }

  .hero-wrap--scroll-zoom {
    overflow: clip;
  }

  .hero-wrap--scroll-zoom .hero__backdrop {
    transform: scale(var(--hero-backdrop-scale, 1));
    transform-origin: center;
    will-change: transform;
  }

  .hero-wrap--scroll-zoom .hero__media {
    transform: scale(var(--hero-media-scale, 1));
    transform-origin: center;
    will-change: transform;
  }

  .hero-wrap--behind-header {
    margin-top: calc(var(--header-height) * -1);
    padding-top: var(--header-height);
  }

  .hero-wrap--full {
    display: grid;
    min-height: 100svh;
  }

  .hero-wrap--full .hero {
    align-content: center;
  }

  .hero-wrap--full .hero--centered {
    gap: var(--space-lg);
    padding-bottom: clamp(7rem, 14vh, 9rem);
  }

  .hero-wrap--full .hero--centered .hero__media {
    order: -1;
    justify-items: center;
  }

  .hero-wrap--full .hero--centered .hero__eyebrow {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
    letter-spacing: var(--tracking-normal);
    text-transform: none;
  }

  .hero {
    display: grid;
    gap: var(--space-xl);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero--centered {
    justify-items: center;
    text-align: center;
  }

  .hero--centered .hero__content {
    max-width: 52rem;
    justify-items: center;
  }

  .hero--split {
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    align-items: center;
  }

  .hero--minimal {
    padding-block: var(--space-lg);
  }

  .hero__content {
    display: grid;
    gap: 1.25rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
    background: color-mix(in srgb, var(--primary) 6%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--primary);
    font-weight: 700;
    width: fit-content;
  }

  .hero__headline {
    margin: 0;
    max-width: 22ch;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero--centered .hero__headline {
    margin-inline: auto;
  }

  .hero__headline--sm {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
  }

  .hero__headline--md {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
  }

  .hero__headline--lg {
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
  }

  .hero__headline--xl {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
  }

  .hero--centered .hero__headline--xl {
    max-width: min(100%, 52rem);
  }

  .hero__headline-typed {
    display: inline-grid;
    grid-template-areas: "typed";
    width: 100%;
    max-width: 100%;
    font-family: var(--font-typewriter);
    font-weight: 850;
    vertical-align: baseline;
    white-space: nowrap;
  }

  .hero__headline-sizer,
  .hero__headline-live {
    grid-area: typed;
  }

  .hero__headline-sizer {
    padding-right: 0.22em;
    overflow-wrap: anywhere;
    visibility: hidden;
  }

  .hero__headline-live {
    display: block;
    width: 100%;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .hero__headline-caret {
    color: var(--primary);
    font-weight: 400;
    animation: hero-typewriter-caret 0.75s step-end infinite;
  }

  .hero__subheadline {
    margin: 0;
    max-width: 38rem;
    color: var(--muted-foreground);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    line-height: 1.6;
  }

  .hero--centered .hero__subheadline {
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .hero--centered .hero__actions {
    justify-content: center;
  }

  .hero__media {
    display: grid;
    align-items: center;
  }

  .hero__footer {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    width: min(100% - var(--space-xl), 40rem);
    text-align: center;
    transform: translateX(-50%);
  }

  .hero__footer p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }

  .hero__scroll {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__scroll :global(svg) {
    animation: hero-scroll-drift 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__scroll:hover {
    color: var(--foreground);
  }

  .hero__scroll:hover :global(svg) {
    transform: translateY(var(--spacing-1));
  }

  .hero__scroll:focus-visible {
    border-radius: var(--radius-sm);
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  @keyframes hero-scroll-drift {
    0%,
    100% {
      opacity: 0.55;
      transform: translateY(0);
    }

    50% {
      opacity: 1;
      transform: translateY(var(--spacing-2));
    }
  }

  @keyframes hero-typewriter-caret {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 48rem) {
    .hero--split {
      grid-template-columns: 1fr;
    }

    .hero-wrap--full .hero--centered {
      gap: var(--space-md);
      padding-bottom: 7rem;
    }

    .hero__headline-typed {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll,
    .hero__scroll :global(svg),
    .hero__headline-caret {
      animation: none;
      transition: none;
    }

    .hero__headline-caret {
      opacity: 1;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll("[data-hero-typewriter]").forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    if (element.dataset.typewriterReady === "true") return;

    const output = element.querySelector("[data-typewriter-output]");
    const text = element.dataset.heroTypewriter ?? "";
    if (!(output instanceof HTMLElement) || !text) return;

    element.dataset.typewriterReady = "true";
    if (reduceMotion) {
      output.textContent = text;
      return;
    }

    const characters = Array.from(text);
    const shouldLoop = element.hasAttribute("data-typewriter-loop");
    const characterDelay = 150;
    const phrasePause = 1100;
    let index = 0;

    const typeNextCharacter = () => {
      if (!element.isConnected) return;
      index += 1;
      output.textContent = characters.slice(0, index).join("");
      if (index < characters.length) {
        const currentCharacter = characters[index - 1];
        const nextDelay =
          currentCharacter === "，" ? phrasePause : characterDelay;
        window.setTimeout(typeNextCharacter, nextDelay);
      } else if (shouldLoop) {
        window.setTimeout(startTypingCycle, 2500);
      }
    };

    const startTypingCycle = () => {
      if (!element.isConnected) return;
      index = 0;
      output.textContent = "";
      window.setTimeout(typeNextCharacter, 450);
    };

    startTypingCycle();
  });

  document.querySelectorAll("[data-hero-scroll-zoom]").forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    if (element.dataset.scrollZoomReady === "true" || reduceMotion) return;

    element.dataset.scrollZoomReady = "true";
    let frame = 0;

    const updateScale = () => {
      frame = 0;
      const progress = Math.min(
        Math.max(
          -element.getBoundingClientRect().top / element.offsetHeight,
          0,
        ),
        1,
      );
      element.style.setProperty(
        "--hero-backdrop-scale",
        String(1 + progress * 0.45),
      );
      element.style.setProperty(
        "--hero-media-scale",
        String(1 + progress * 0.18),
      );
    };

    const requestScaleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateScale);
    };

    updateScale();
    window.addEventListener("scroll", requestScaleUpdate, { passive: true });
  });
</script>
