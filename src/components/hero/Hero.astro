---
import { type Locale } from "../../lib/site-config";
import { resolveRoute } from "../../i18n/routes";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Button, Icon } from "../ui/index";
import { heroVariantClasses, type HeroVariant } from "./hero.variants";

export interface Cta {
  label: string;
  href: string;
}

export interface Props {
  variant?: HeroVariant;
  size?: "sm" | "md" | "lg" | "xl";
  eyebrow?: string;
  headline?: string;
  title?: string;
  subheadline?: string;
  content?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  ctaText?: string;
  ctaHref?: string;
  locale?: Locale;
  extendBehindHeader?: boolean;
  fullViewport?: boolean;
  scrollTarget?: string;
  scrollLabel?: string;
  footerText?: string;
  animatedHeadlineText?: string;
  mobileHeadlineBreakAfter?: string;
  typewriterLoop?: boolean;
  scrollZoom?: boolean;
  asciiBackground?: ImageMetadata;
  asciiEntrance?: "ripple";
}

const props = Astro.props as Props;
const variant = props.variant ?? "centered";
const headline = props.headline ?? props.title ?? "";
const subheadline = props.subheadline ?? props.content;
const locale = props.locale ?? "zh-CN";
const primaryCta =
  props.primaryCta ??
  (props.ctaText && props.ctaHref
    ? { label: props.ctaText, href: props.ctaHref }
    : undefined);
const hasImageSlot = Astro.slots.has("image");
const hasEyebrowSlot = Astro.slots.has("eyebrow");
const animatedHeadlineText = props.animatedHeadlineText;
const hasAnimatedHeadline = Boolean(
  animatedHeadlineText && headline.endsWith(animatedHeadlineText),
);
const headlinePrefix = hasAnimatedHeadline
  ? headline.slice(0, -animatedHeadlineText!.length).trimEnd()
  : "";
const mobileHeadlineBreakIndex =
  hasAnimatedHeadline && props.mobileHeadlineBreakAfter
    ? animatedHeadlineText!.indexOf(props.mobileHeadlineBreakAfter) +
      props.mobileHeadlineBreakAfter.length
    : 0;
const hasMobileHeadlineBreak =
  mobileHeadlineBreakIndex > 0 &&
  mobileHeadlineBreakIndex < (animatedHeadlineText?.length ?? 0);
const animatedHeadlineFirstLine = hasMobileHeadlineBreak
  ? animatedHeadlineText!.slice(0, mobileHeadlineBreakIndex)
  : animatedHeadlineText;
const animatedHeadlineSecondLine = hasMobileHeadlineBreak
  ? animatedHeadlineText!.slice(mobileHeadlineBreakIndex)
  : "";
---

<div
  class:list={[
    "hero-wrap",
    { "hero-wrap--behind-header": props.extendBehindHeader },
    { "hero-wrap--full": props.fullViewport },
    { "hero-wrap--scroll-zoom": props.scrollZoom },
    { "hero-wrap--ascii": props.asciiBackground },
  ]}
  data-hero-scroll-zoom={props.scrollZoom ? "" : undefined}
  data-ascii-entrance={props.asciiEntrance}
  data-ascii-entrance-state={props.asciiEntrance ? "idle" : undefined}
>
  <div
    class:list={[
      "hero__backdrop",
      { "hero__backdrop--ascii": props.asciiBackground },
    ]}
    aria-hidden="true"
  >
    {
      props.asciiBackground ? (
        <span
          class="hero__ascii"
          data-hero-ascii
          data-ascii-src={props.asciiBackground.src}
        >
          <Image
            class="hero__ascii-image"
            src={props.asciiBackground}
            alt=""
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="100vw"
            quality={78}
            loading="eager"
            decoding="async"
            data-ascii-source
          />
          <span class="hero__ascii-tint" />
          <canvas class="hero__ascii-canvas" data-ascii-canvas />
          <span class="hero__ascii-veil" />
        </span>
      ) : (
        <span class="bg-grid" />
      )
    }
    <span class="bg-glow"></span>
  </div>
  {
    props.fullViewport && props.asciiBackground && (
      <span class="hero__transition" aria-hidden="true" />
    )
  }
  <section class={`${heroVariantClasses[variant]} container`}>
    <div class="hero__content">
      {
        (props.eyebrow || hasEyebrowSlot) && (
          <p class="hero__eyebrow">
            {hasEyebrowSlot ? <slot name="eyebrow" /> : props.eyebrow}
          </p>
        )
      }
      {
        headline && (
          <h1 class={`hero__headline hero__headline--${props.size ?? "lg"}`}>
            {hasAnimatedHeadline ? (
              <>
                {headlinePrefix && (
                  <>
                    <span>{headlinePrefix}</span>{" "}
                  </>
                )}
                <span
                  class="hero__headline-typed"
                  aria-label={animatedHeadlineText}
                  data-hero-typewriter={animatedHeadlineText}
                  data-typewriter-mobile-break-index={
                    hasMobileHeadlineBreak
                      ? mobileHeadlineBreakIndex
                      : undefined
                  }
                  data-typewriter-loop={props.typewriterLoop ? "" : undefined}
                >
                  <span class="hero__headline-sizer" aria-hidden="true">
                    {animatedHeadlineFirstLine}
                    {hasMobileHeadlineBreak && (
                      <br class="hero__headline-mobile-break" />
                    )}
                    {animatedHeadlineSecondLine}
                  </span>
                  <span class="hero__headline-live" aria-hidden="true">
                    <span data-typewriter-output>
                      {animatedHeadlineFirstLine}
                      {hasMobileHeadlineBreak && (
                        <br class="hero__headline-mobile-break" />
                      )}
                      {animatedHeadlineSecondLine}
                    </span>
                    <span class="hero__headline-caret">|</span>
                  </span>
                </span>
              </>
            ) : (
              headline
            )}
          </h1>
        )
      }
      {subheadline && <p class="hero__subheadline">{subheadline}</p>}
      {
        (primaryCta || props.secondaryCta) && (
          <div class="hero__actions">
            {primaryCta && (
              <Button href={resolveRoute(locale, primaryCta.href)}>
                {primaryCta.label}
              </Button>
            )}
            {props.secondaryCta && (
              <Button
                href={resolveRoute(locale, props.secondaryCta.href)}
                variant="secondary"
              >
                {props.secondaryCta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>

    {
      (hasImageSlot || variant === "split") && (
        <div class="hero__media">
          <slot name="image" />
        </div>
      )
    }
  </section>

  {
    (props.footerText || props.scrollTarget) && (
      <div class="hero__footer">
        {props.footerText && <p>{props.footerText}</p>}
        {props.scrollTarget && (
          <a
            class="hero__scroll"
            href={`#${props.scrollTarget}`}
            aria-label={props.scrollLabel ?? "Scroll to the next section"}
          >
            {!props.footerText && (
              <span>{props.scrollLabel ?? "Scroll to explore"}</span>
            )}
            <Icon name="lucide:chevron-down" size="1.25rem" />
          </a>
        )}
      </div>
    )
  }
</div>

<style>
  @font-face {
    font-family: "Genshin HYWenHei 85W";
    src: url("../../../materials/fonts/希腊语纠正版原神汉仪文黑85W.ttf")
      format("truetype");
    font-weight: 850;
    font-style: normal;
    font-display: swap;
  }

  .hero-wrap {
    position: relative;
    isolation: isolate;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__backdrop :global(.bg-grid),
  .hero__backdrop :global(.bg-glow),
  .hero__ascii {
    z-index: 0;
  }

  .hero__backdrop--ascii :global(.bg-glow) {
    opacity: 65%;
    animation: none;
  }

  .hero__transition {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    z-index: 0;
    height: var(--hero-transition-depth);
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--background) 10%, transparent) 28%,
      color-mix(in srgb, var(--background) 42%, transparent) 56%,
      color-mix(in srgb, var(--background) 78%, transparent) 78%,
      var(--background) 100%
    );
    backdrop-filter: blur(var(--hero-transition-blur, 0.75rem));
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      var(--foreground) 62%,
      var(--foreground) 100%
    );
    pointer-events: none;
    transform: translateZ(0);
  }

  .hero__ascii,
  .hero__ascii-image,
  .hero__ascii-tint,
  .hero__ascii-canvas,
  .hero__ascii-veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__ascii {
    overflow: hidden;
    opacity: 42%;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__ascii-image {
    object-fit: cover;
    object-position: center;
    filter: contrast(1.15) grayscale(0.28) saturate(1);
    opacity: calc(0.92 * var(--hero-ascii-scene-opacity, 1));
  }

  .hero__ascii-tint {
    background: var(--hero-ascii-tint);
    mix-blend-mode: soft-light;
    opacity: calc(0.38 * var(--hero-ascii-scene-opacity, 1));
  }

  .hero__ascii-canvas {
    z-index: 1;
    display: block;
    mix-blend-mode: multiply;
    opacity: 74%;
    filter: drop-shadow(
      0 0 0.45rem color-mix(in srgb, var(--hero-ascii-tint) 45%, transparent)
    );
  }

  .hero__ascii-veil {
    z-index: 2;
    background: radial-gradient(
      ellipse 78% 74% at 50% 52%,
      transparent 42%,
      color-mix(in srgb, var(--background) 55%, transparent) 100%
    );
    opacity: var(--hero-ascii-scene-opacity, 1);
  }

  .hero-wrap[data-ascii-entrance-state="playing"] .hero__content,
  .hero-wrap[data-ascii-entrance-state="playing"] .hero__footer {
    opacity: 0;
  }

  .hero-wrap[data-ascii-entrance-state="playing"] .hero__ascii {
    opacity: 78%;
  }

  :global(html.dark) .hero__ascii {
    opacity: 32%;
  }

  :global(html.dark) .hero__ascii-image {
    filter: contrast(1.15) grayscale(0.28) saturate(1) brightness(0.58);
  }

  :global(html.dark) .hero__ascii-canvas {
    mix-blend-mode: screen;
    opacity: 68%;
  }

  .hero-wrap--scroll-zoom {
    overflow: clip;
  }

  .hero-wrap--scroll-zoom .hero__backdrop {
    transform: scale(var(--hero-backdrop-scale, 1));
    transform-origin: center;
    will-change: transform;
  }

  .hero-wrap--scroll-zoom .hero__media {
    transform: scale(var(--hero-media-scale, 1));
    transform-origin: center;
    will-change: transform;
  }

  .hero-wrap--behind-header {
    margin-top: calc(var(--header-height) * -1);
    padding-top: var(--header-height);
  }

  .hero-wrap--full {
    display: grid;
    min-height: 100svh;
  }

  .hero-wrap--full.hero-wrap--ascii {
    --hero-spill-depth: var(--space-3xl);
    --hero-transition-depth: calc(
      var(--space-3xl) + var(--space-3xl) + var(--space-2xl)
    );

    min-height: calc(100svh + var(--hero-spill-depth));
  }

  .hero-wrap--full .hero {
    align-content: center;
  }

  .hero-wrap--full .hero--centered {
    gap: var(--space-lg);
    padding-bottom: clamp(7rem, 14vh, 9rem);
  }

  .hero-wrap--full .hero--centered .hero__media {
    order: -1;
    justify-items: center;
  }

  .hero-wrap--full .hero--centered .hero__eyebrow {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
    letter-spacing: var(--tracking-normal);
    text-transform: none;
  }

  .hero-wrap--full.hero-wrap--ascii .hero__content {
    position: absolute;
    z-index: 1;
    bottom: calc(
      var(--hero-spill-depth) + var(--space-lg) + var(--header-height-mobile) +
        var(--space-lg) + var(--space-md)
    );
    left: 50%;
    width: min(calc(100% - var(--space-xl)), 52rem);
    translate: -50% 0;
  }

  .hero {
    display: grid;
    gap: var(--space-xl);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero--centered {
    justify-items: center;
    text-align: center;
  }

  .hero--centered .hero__content {
    max-width: 52rem;
    justify-items: center;
  }

  .hero--split {
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    align-items: center;
  }

  .hero--minimal {
    padding-block: var(--space-lg);
  }

  .hero__content {
    display: grid;
    gap: 1.25rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent);
    background: color-mix(in srgb, var(--primary) 6%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--primary);
    font-weight: 700;
    width: fit-content;
  }

  .hero__headline {
    margin: 0;
    max-width: 22ch;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero--centered .hero__headline {
    margin-inline: auto;
  }

  .hero__headline--sm {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
  }

  .hero__headline--md {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
  }

  .hero__headline--lg {
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
  }

  .hero__headline--xl {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
  }

  .hero--centered .hero__headline--xl {
    max-width: min(100%, 52rem);
  }

  .hero__headline-typed {
    display: inline-grid;
    grid-template-areas: "typed";
    width: 100%;
    max-width: 100%;
    font-family: var(--font-typewriter);
    font-weight: 850;
    vertical-align: baseline;
    white-space: nowrap;
  }

  .hero__headline-sizer,
  .hero__headline-live {
    grid-area: typed;
  }

  .hero__headline-sizer {
    padding-right: 0.22em;
    overflow-wrap: anywhere;
    visibility: hidden;
  }

  .hero__headline-live {
    display: block;
    width: 100%;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .hero__headline-caret {
    color: var(--primary);
    font-weight: 400;
    animation: hero-typewriter-caret 0.75s step-end infinite;
  }

  .hero__headline-typed[data-typewriter-state="complete"]
    .hero__headline-caret {
    visibility: hidden;
    animation: none;
  }

  :global(.hero__headline-mobile-break) {
    display: none;
  }

  .hero__subheadline {
    margin: 0;
    max-width: 38rem;
    color: var(--muted-foreground);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    line-height: 1.6;
  }

  .hero--centered .hero__subheadline {
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .hero--centered .hero__actions {
    justify-content: center;
  }

  .hero__media {
    display: grid;
    align-items: center;
  }

  .hero__footer {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    width: min(100% - var(--space-xl), 40rem);
    text-align: center;
    transform: translateX(-50%);
  }

  .hero-wrap--full.hero-wrap--ascii .hero__footer {
    bottom: calc(var(--hero-spill-depth) + var(--space-lg));
  }

  .hero__footer p {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-cjk-serif);
    font-size: var(--text-sm);
  }

  .hero__scroll {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__scroll :global(svg) {
    animation: hero-scroll-drift 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__scroll:hover {
    color: var(--foreground);
  }

  .hero__scroll:hover :global(svg) {
    transform: translateY(var(--spacing-1));
  }

  .hero__scroll:focus-visible {
    border-radius: var(--radius-sm);
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  @keyframes hero-scroll-drift {
    0%,
    100% {
      opacity: 0.55;
      transform: translateY(0);
    }

    50% {
      opacity: 1;
      transform: translateY(var(--spacing-2));
    }
  }

  @keyframes hero-typewriter-caret {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 48rem) {
    .hero-wrap--full.hero-wrap--ascii {
      --hero-spill-depth: var(--space-2xl);
      --hero-transition-depth: calc(var(--space-3xl) + var(--space-2xl));
    }

    .hero--split {
      grid-template-columns: 1fr;
    }

    .hero-wrap--full .hero--centered {
      gap: var(--space-md);
      padding-bottom: 7rem;
    }

    .hero__headline-typed {
      white-space: normal;
    }

    :global(.hero__headline-mobile-break) {
      display: block;
    }

    .hero__ascii {
      opacity: 34%;
    }

    .hero__ascii-veil {
      background: radial-gradient(
        ellipse 88% 78% at 50% 52%,
        transparent 38%,
        color-mix(in srgb, var(--background) 58%, transparent) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll,
    .hero__scroll :global(svg),
    .hero__headline-caret {
      animation: none;
      transition: none;
    }

    .hero-wrap[data-ascii-entrance-state] .hero__content,
    .hero-wrap[data-ascii-entrance-state] .hero__footer {
      opacity: 1;
      transition: none;
    }

    .hero-wrap[data-ascii-entrance-state] .hero__ascii {
      transition: none;
    }
  }
</style>

<script>
  const motionPreference = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  const reduceMotion = motionPreference.matches;

  const ASCII_ENTRANCE_SESSION_KEY = "hero-ascii-ripple:v3";

  const settleAsciiEntrance = (root: HTMLElement, reason: string) => {
    root.dataset.asciiEntranceState = "complete";
    root.dataset.asciiEntranceReason = reason;
    delete root.dataset.asciiImpact;
    root.style.removeProperty("--hero-ascii-scene-opacity");
    root.dispatchEvent(new CustomEvent("hero-ascii-ready"));
  };

  document
    .querySelectorAll('[data-ascii-entrance="ripple"]')
    .forEach((root) => {
      if (!(root instanceof HTMLElement)) return;

      if (reduceMotion) {
        settleAsciiEntrance(root, "reduced-motion");
        return;
      }

      try {
        root.dataset.asciiEntranceState = window.sessionStorage.getItem(
          ASCII_ENTRANCE_SESSION_KEY,
        )
          ? "complete"
          : "armed";
        root.dataset.asciiEntranceReason = root.dataset.asciiEntranceState;
      } catch {
        settleAsciiEntrance(root, "storage-unavailable");
      }
    });

  document.querySelectorAll("[data-hero-typewriter]").forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    if (element.dataset.typewriterReady === "true") return;

    const output = element.querySelector("[data-typewriter-output]");
    const text = element.dataset.heroTypewriter ?? "";
    if (!(output instanceof HTMLElement) || !text) return;

    element.dataset.typewriterReady = "true";
    const characters = Array.from(text);
    const mobileBreakIndex = Number(
      element.dataset.typewriterMobileBreakIndex ?? 0,
    );
    const mobileBreakCharacterIndex = Array.from(
      text.slice(0, mobileBreakIndex),
    ).length;
    const renderText = (length: number) => {
      const visibleCharacters = characters.slice(0, length);
      if (
        mobileBreakCharacterIndex <= 0 ||
        mobileBreakCharacterIndex >= characters.length ||
        length < mobileBreakCharacterIndex
      ) {
        output.textContent = visibleCharacters.join("");
        return;
      }

      const mobileBreak = document.createElement("br");
      mobileBreak.className = "hero__headline-mobile-break";
      output.replaceChildren(
        document.createTextNode(
          visibleCharacters.slice(0, mobileBreakCharacterIndex).join(""),
        ),
        mobileBreak,
        document.createTextNode(
          visibleCharacters.slice(mobileBreakCharacterIndex).join(""),
        ),
      );
    };

    if (reduceMotion) {
      renderText(text.length);
      element.dataset.typewriterState = "complete";
      return;
    }

    const shouldLoop = element.hasAttribute("data-typewriter-loop");
    const characterDelay = 150;
    const phrasePause = 1100;
    let index = 0;

    const typeNextCharacter = () => {
      if (!element.isConnected) return;
      index += 1;
      renderText(index);
      if (index < characters.length) {
        const currentCharacter = characters[index - 1];
        const nextDelay =
          currentCharacter === "，" ? phrasePause : characterDelay;
        window.setTimeout(typeNextCharacter, nextDelay);
      } else if (shouldLoop) {
        window.setTimeout(startTypingCycle, 2500);
      } else {
        element.dataset.typewriterState = "complete";
      }
    };

    const startTypingCycle = () => {
      if (!element.isConnected) return;
      index = 0;
      delete element.dataset.typewriterState;
      renderText(0);
      window.setTimeout(typeNextCharacter, 450);
    };

    let typingStarted = false;
    const beginTyping = () => {
      if (typingStarted) return;
      typingStarted = true;
      startTypingCycle();
    };

    const homeResourceState =
      document.documentElement.dataset.homeResourceState;
    if (homeResourceState === "waiting" || homeResourceState === "loading") {
      window.addEventListener("home-resources-ready", beginTyping, {
        once: true,
      });
      return;
    }

    const entranceRoot = element.closest('[data-ascii-entrance="ripple"]');
    if (
      entranceRoot instanceof HTMLElement &&
      entranceRoot.dataset.asciiEntranceState !== "complete"
    ) {
      entranceRoot.addEventListener("hero-ascii-ready", beginTyping, {
        once: true,
      });
      return;
    }

    beginTyping();
  });

  document.querySelectorAll("[data-hero-scroll-zoom]").forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    if (element.dataset.scrollZoomReady === "true" || reduceMotion) return;

    element.dataset.scrollZoomReady = "true";
    let frame = 0;

    const updateScale = () => {
      frame = 0;
      const progress = Math.min(
        Math.max(
          -element.getBoundingClientRect().top / element.offsetHeight,
          0,
        ),
        1,
      );
      element.style.setProperty(
        "--hero-backdrop-scale",
        String(1 + progress * 0.45),
      );
      element.style.setProperty(
        "--hero-media-scale",
        String(1 + progress * 0.18),
      );
      element.style.setProperty(
        "--hero-transition-blur",
        `${12 + progress * 10}px`,
      );
    };

    const requestScaleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateScale);
    };

    updateScale();
    window.addEventListener("scroll", requestScaleUpdate, { passive: true });
  });

  const ASCII_CHARACTERS = " .,:;irsXA253hMHGS#9B&@";
  const ASCII_MOTION_CHARACTERS = "abcdefghijklmnopqrstuvwxyz!@#$%&*";
  const ASCII_CELL_SIZE = 13;
  const ASCII_CONTRAST = 1.15;
  const ASCII_GRAYSCALE = 0.28;
  const ASCII_TINT_OPACITY = 0.38;
  const ASCII_FOREGROUND_MIX = 0.72;
  const ASCII_BACKGROUND_ALPHA = 0.12;
  const ASCII_BACKGROUND_FADE_START = 0.04;
  const ASCII_BACKGROUND_FADE_RANGE = 0.16;
  const ASCII_ENTRANCE_FRAME_INTERVAL = 1000 / 30;
  const ASCII_MOTION_FRAME_INTERVAL = 1000 / 12;
  const ASCII_MOTION_CELLS_PER_FRAME = 0.06;
  const ASCII_ENTRANCE_RING_END = 1100;
  const ASCII_ENTRANCE_MORPH_START = 900;
  const ASCII_ENTRANCE_LANDSCAPE_START = 1150;
  const ASCII_ENTRANCE_END = 2400;

  const seededNoise = (column: number, row: number, salt: number) => {
    const value = Math.sin(
      (column + 1) * 12.9898 + (row + 1) * 78.233 + salt * 37.719,
    );
    return value * 43758.5453 - Math.floor(value * 43758.5453);
  };

  const clampChannel = (value: number) =>
    Math.min(255, Math.max(0, Math.round(value)));

  const mixChannel = (source: number, target: number, amount: number) =>
    clampChannel(source * (1 - amount) + target * amount);

  const clampUnit = (value: number) => Math.min(1, Math.max(0, value));
  const interpolate = (start: number, end: number, progress: number) =>
    start + (end - start) * progress;
  const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);
  const smoothStep = (value: number) => value * value * (3 - 2 * value);

  const softLightChannel = (baseValue: number, tintValue: number) => {
    const base = baseValue / 255;
    const tint = tintValue / 255;
    const curve =
      base <= 0.25 ? ((16 * base - 12) * base + 4) * base : Math.sqrt(base);
    const blended =
      tint <= 0.5
        ? base - (1 - 2 * tint) * base * (1 - base)
        : base + (2 * tint - 1) * (curve - base);
    return clampChannel(
      baseValue * (1 - ASCII_TINT_OPACITY) + blended * 255 * ASCII_TINT_OPACITY,
    );
  };

  document.querySelectorAll("[data-hero-ascii]").forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    if (element.dataset.asciiReady === "true") return;

    const root = element.closest(".hero-wrap");
    const canvas = element.querySelector("[data-ascii-canvas]");
    const sourceImage = element.querySelector("[data-ascii-source]");
    if (!(root instanceof HTMLElement)) return;
    if (!(canvas instanceof HTMLCanvasElement)) {
      settleAsciiEntrance(root, "canvas-unavailable");
      return;
    }
    if (!(sourceImage instanceof HTMLImageElement)) {
      settleAsciiEntrance(root, "image-unavailable");
      return;
    }

    const context = canvas.getContext("2d", { alpha: true });
    const sampleCanvas = document.createElement("canvas");
    const sampleContext = sampleCanvas.getContext("2d", {
      alpha: false,
      willReadFrequently: true,
    });
    const colorCanvas = document.createElement("canvas");
    const colorContext = colorCanvas.getContext("2d", {
      alpha: false,
      willReadFrequently: true,
    });
    const finalSceneCanvas = document.createElement("canvas");
    const finalSceneContext = finalSceneCanvas.getContext("2d", {
      alpha: true,
    });
    if (!context || !sampleContext || !colorContext || !finalSceneContext) {
      settleAsciiEntrance(root, "canvas-context-unavailable");
      return;
    }

    element.dataset.asciiReady = "true";
    colorCanvas.width = 1;
    colorCanvas.height = 1;

    interface AsciiCell {
      x: number;
      y: number;
      red: number;
      green: number;
      blue: number;
      alpha: number;
      glyph: string;
      glyphIndex: number;
      glyphDrift: number;
    }

    interface EntranceCell {
      cell: AsciiCell;
      ringX: number;
      ringY: number;
      rotation: number;
      delay: number;
    }

    let cells: AsciiCell[] = [];
    let entranceCells: EntranceCell[] = [];
    let displayWidth = 0;
    let displayHeight = 0;
    let pixelRatio = 1;
    let entranceCenterX = 0;
    let entranceCenterY = 0;
    let resizeTimer = 0;
    let lastFrameTime = 0;
    let imageDecoded = false;
    let entranceStartTime = 0;
    let entranceStarted = false;
    let entranceFallbackTimer = 0;
    let glyphMotionTimer = 0;
    let glyphMotionVisible = false;
    let glyphMotionOrder: number[] = [];
    let glyphMotionCursor = 0;
    let displayedGlyphs: string[] = [];

    const stopGlyphMotion = () => {
      window.clearTimeout(glyphMotionTimer);
      glyphMotionTimer = 0;
    };

    const shuffleGlyphMotionOrder = () => {
      for (let index = glyphMotionOrder.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [glyphMotionOrder[index], glyphMotionOrder[swapIndex]] = [
          glyphMotionOrder[swapIndex],
          glyphMotionOrder[index],
        ];
      }
      glyphMotionCursor = 0;
    };

    const canRunGlyphMotion = () =>
      !motionPreference.matches &&
      glyphMotionVisible &&
      !document.hidden &&
      !entranceStarted &&
      root.dataset.asciiEntranceState !== "armed" &&
      root.dataset.asciiEntranceState !== "playing" &&
      cells.length > 0;

    const drawNextGlyphs = () => {
      glyphMotionTimer = 0;
      if (!canRunGlyphMotion()) return;

      const cellCount = Math.min(
        450,
        Math.max(1, Math.ceil(cells.length * ASCII_MOTION_CELLS_PER_FRAME)),
      );
      for (let updated = 0; updated < cellCount; updated += 1) {
        if (glyphMotionCursor >= glyphMotionOrder.length) {
          shuffleGlyphMotionOrder();
        }
        const cellIndex = glyphMotionOrder[glyphMotionCursor++];
        const cell = cells[cellIndex];
        const previousGlyph = displayedGlyphs[cellIndex];
        let nextGlyph =
          ASCII_MOTION_CHARACTERS[
            Math.floor(Math.random() * ASCII_MOTION_CHARACTERS.length)
          ];
        if (nextGlyph === previousGlyph) {
          nextGlyph =
            ASCII_MOTION_CHARACTERS[
              (ASCII_MOTION_CHARACTERS.indexOf(nextGlyph) + 1) %
                ASCII_MOTION_CHARACTERS.length
            ];
        }

        displayedGlyphs[cellIndex] = nextGlyph;
        context.clearRect(
          cell.x - ASCII_CELL_SIZE / 2,
          cell.y - ASCII_CELL_SIZE / 2,
          ASCII_CELL_SIZE,
          ASCII_CELL_SIZE,
        );
        context.fillStyle = `rgb(${cell.red} ${cell.green} ${cell.blue} / ${cell.alpha})`;
        context.fillText(nextGlyph, cell.x, cell.y);
      }

      glyphMotionTimer = window.setTimeout(
        drawNextGlyphs,
        ASCII_MOTION_FRAME_INTERVAL,
      );
    };

    const startGlyphMotion = () => {
      if (glyphMotionTimer || !canRunGlyphMotion()) return;
      glyphMotionTimer = window.setTimeout(
        drawNextGlyphs,
        ASCII_MOTION_FRAME_INTERVAL,
      );
    };

    const readCanvasColor = (color: string) => {
      colorContext.clearRect(0, 0, 1, 1);
      colorContext.fillStyle = color;
      colorContext.fillRect(0, 0, 1, 1);
      return colorContext.getImageData(0, 0, 1, 1).data;
    };

    const buildEntranceCells = () => {
      entranceCells = [];
      if (!cells.length) return;

      const bounds = element.getBoundingClientRect();
      entranceCenterX = Math.min(
        displayWidth,
        Math.max(0, window.innerWidth / 2 - bounds.left),
      );
      entranceCenterY = Math.min(
        displayHeight,
        Math.max(0, window.innerHeight / 2 - bounds.top),
      );

      const isMobile = window.matchMedia("(max-width: 48rem)").matches;
      const cellLimit = isMobile ? 560 : 960;
      const targetCount = Math.min(cellLimit, cells.length);
      const innerRadius = isMobile ? 34 : 44;
      const ringCount = isMobile ? 9 : 13;
      const farthestX = Math.max(
        entranceCenterX,
        displayWidth - entranceCenterX,
      );
      const farthestY = Math.max(
        entranceCenterY,
        displayHeight - entranceCenterY,
      );
      const maxRadius = Math.hypot(farthestX, farthestY) * 1.04;
      const ringPoints: Array<{
        x: number;
        y: number;
        rotation: number;
        delay: number;
      }> = [];

      const radii = Array.from({ length: ringCount }, (_, index) =>
        interpolate(innerRadius, maxRadius, index / (ringCount - 1)),
      );
      const radiusTotal = radii.reduce((total, radius) => total + radius, 0);

      for (let ring = 0; ring < radii.length; ring += 1) {
        const radius = radii[ring];
        const remainingRings = radii.length - ring - 1;
        const availablePoints = targetCount - ringPoints.length;
        const pointCount = Math.max(
          8,
          Math.min(
            availablePoints - remainingRings * 8,
            Math.round((targetCount * radius) / radiusTotal),
          ),
        );
        const ringOffset = seededNoise(radius, pointCount, 11) * Math.PI * 2;
        const normalizedRadius = clampUnit(radius / maxRadius);

        for (let point = 0; point < pointCount; point += 1) {
          const angle = ringOffset + (point / pointCount) * Math.PI * 2;
          ringPoints.push({
            x: entranceCenterX + Math.cos(angle) * radius,
            y: entranceCenterY + Math.sin(angle) * radius,
            rotation: angle - Math.PI / 2,
            delay: normalizedRadius * 0.3,
          });
        }
      }

      const actualCount = Math.min(targetCount, ringPoints.length);
      for (let index = 0; index < actualCount; index += 1) {
        const cellIndex = Math.min(
          cells.length - 1,
          Math.floor((index * cells.length) / actualCount),
        );
        const cell = cells[cellIndex];
        const point = ringPoints[index];
        entranceCells.push({
          cell,
          ringX: point.x,
          ringY: point.y,
          rotation: point.rotation,
          delay: point.delay,
        });
      }

      element.dataset.asciiEntranceGlyphCount = String(entranceCells.length);
      element.dataset.asciiEntranceCenter = `${Math.round(entranceCenterX)},${Math.round(entranceCenterY)}`;
    };

    const beginEntrance = () => {
      if (
        entranceStarted ||
        root.dataset.asciiEntranceState !== "armed" ||
        !entranceCells.length
      ) {
        return false;
      }

      try {
        window.sessionStorage.setItem(ASCII_ENTRANCE_SESSION_KEY, "played");
      } catch {
        settleAsciiEntrance(root, "storage-unavailable");
        return false;
      }

      window.clearTimeout(entranceFallbackTimer);
      entranceStarted = true;
      entranceStartTime = performance.now();
      root.dataset.asciiEntranceState = "playing";
      root.dataset.asciiEntranceReason = "first-visit";
      root.style.setProperty("--hero-ascii-scene-opacity", "0");
      return true;
    };

    const renderFinalScene = (fontFamily: string) => {
      finalSceneCanvas.width = canvas.width;
      finalSceneCanvas.height = canvas.height;
      finalSceneContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      finalSceneContext.clearRect(0, 0, displayWidth, displayHeight);
      finalSceneContext.font = `${ASCII_CELL_SIZE * 0.88}px ${fontFamily}`;
      finalSceneContext.textAlign = "center";
      finalSceneContext.textBaseline = "middle";

      for (const cell of cells) {
        finalSceneContext.fillStyle = `rgb(${cell.red} ${cell.green} ${cell.blue} / ${cell.alpha})`;
        finalSceneContext.fillText(cell.glyph, cell.x, cell.y);
      }
    };

    const buildCells = () => {
      if (!imageDecoded || sourceImage.naturalWidth <= 0) return;

      stopGlyphMotion();

      const bounds = element.getBoundingClientRect();
      displayWidth = Math.max(1, Math.round(bounds.width));
      displayHeight = Math.max(1, Math.round(bounds.height));

      pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(displayWidth * pixelRatio);
      canvas.height = Math.round(displayHeight * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

      const columns = Math.max(1, Math.ceil(displayWidth / ASCII_CELL_SIZE));
      const rows = Math.max(1, Math.ceil(displayHeight / ASCII_CELL_SIZE));
      sampleCanvas.width = columns;
      sampleCanvas.height = rows;

      const sourceWidth = sourceImage.naturalWidth;
      const sourceHeight = sourceImage.naturalHeight;
      const scale = Math.max(columns / sourceWidth, rows / sourceHeight);
      const drawWidth = sourceWidth * scale;
      const drawHeight = sourceHeight * scale;
      const drawX = (columns - drawWidth) / 2;
      const drawY = (rows - drawHeight) / 2;

      sampleContext.clearRect(0, 0, columns, rows);
      sampleContext.drawImage(sourceImage, drawX, drawY, drawWidth, drawHeight);

      const pixels = sampleContext.getImageData(0, 0, columns, rows).data;
      const computed = getComputedStyle(element);
      const tint = readCanvasColor(
        computed.getPropertyValue("--hero-ascii-tint").trim(),
      );
      const foreground = readCanvasColor(computed.color);
      const nextCells: AsciiCell[] = [];

      for (let row = 0; row < rows; row += 1) {
        for (let column = 0; column < columns; column += 1) {
          const pixelIndex = (row * columns + column) * 4;
          let red = pixels[pixelIndex];
          let green = pixels[pixelIndex + 1];
          let blue = pixels[pixelIndex + 2];

          red = (red - 127.5) * ASCII_CONTRAST + 127.5;
          green = (green - 127.5) * ASCII_CONTRAST + 127.5;
          blue = (blue - 127.5) * ASCII_CONTRAST + 127.5;

          const luminance = red * 0.2126 + green * 0.7152 + blue * 0.0722;
          red = red * (1 - ASCII_GRAYSCALE) + luminance * ASCII_GRAYSCALE;
          green = green * (1 - ASCII_GRAYSCALE) + luminance * ASCII_GRAYSCALE;
          blue = blue * (1 - ASCII_GRAYSCALE) + luminance * ASCII_GRAYSCALE;

          red = softLightChannel(red, tint[0]);
          green = softLightChannel(green, tint[1]);
          blue = softLightChannel(blue, tint[2]);

          const adjustedLuminance =
            red * 0.2126 + green * 0.7152 + blue * 0.0722;
          const darkness = Math.min(
            1,
            Math.max(0, (255 - adjustedLuminance) / 218),
          );
          const isBackground = darkness < 0.035;
          const backgroundBlend = smoothStep(
            clampUnit(
              (darkness - ASCII_BACKGROUND_FADE_START) /
                ASCII_BACKGROUND_FADE_RANGE,
            ),
          );

          red = mixChannel(red, foreground[0], ASCII_FOREGROUND_MIX);
          green = mixChannel(green, foreground[1], ASCII_FOREGROUND_MIX);
          blue = mixChannel(blue, foreground[2], ASCII_FOREGROUND_MIX);

          const glyphNoise = seededNoise(column, row, 5);
          const glyphIndex = Math.max(
            1,
            Math.min(
              ASCII_CHARACTERS.length - 1,
              Math.floor(darkness * ASCII_CHARACTERS.length),
            ),
          );

          nextCells.push({
            x: (column + 0.5) * ASCII_CELL_SIZE,
            y: (row + 0.5) * ASCII_CELL_SIZE,
            red: clampChannel(red),
            green: clampChannel(green),
            blue: clampChannel(blue),
            alpha: interpolate(
              ASCII_BACKGROUND_ALPHA,
              Math.min(0.92, 0.18 + darkness * 0.78),
              backgroundBlend,
            ),
            glyph: isBackground
              ? ASCII_MOTION_CHARACTERS[
                  Math.floor(glyphNoise * ASCII_MOTION_CHARACTERS.length)
                ]
              : ASCII_CHARACTERS[glyphIndex],
            glyphIndex,
            glyphDrift: Math.floor(glyphNoise * 5) - 2,
          });
        }
      }

      cells = nextCells;
      displayedGlyphs = cells.map((cell) => cell.glyph);
      glyphMotionOrder = cells.map((_, index) => index);
      shuffleGlyphMotionOrder();
      element.dataset.asciiCellCount = String(cells.length);
      renderFinalScene(
        getComputedStyle(element).getPropertyValue("--font-mono").trim(),
      );
      buildEntranceCells();
      beginEntrance();
      renderFrame(performance.now(), true);
      startGlyphMotion();
    };

    const drawRotatedGlyph = (
      glyph: string,
      x: number,
      y: number,
      rotation: number,
    ) => {
      context.save();
      context.translate(x, y);
      context.rotate(rotation);
      context.fillText(glyph, 0, 0);
      context.restore();
    };

    const drawEntranceFrame = (time: number, fontFamily: string) => {
      const elapsed = Math.max(0, time - entranceStartTime);
      context.font = `${ASCII_CELL_SIZE * 0.9}px ${fontFamily}`;

      const ringProgress = clampUnit(elapsed / ASCII_ENTRANCE_RING_END);
      const morphProgress = smoothStep(
        clampUnit(
          (elapsed - ASCII_ENTRANCE_MORPH_START) /
            (ASCII_ENTRANCE_END - ASCII_ENTRANCE_MORPH_START),
        ),
      );
      const sceneOpacity = easeOutCubic(
        clampUnit((elapsed - 1250) / (ASCII_ENTRANCE_END - 1250)),
      );
      root.style.setProperty(
        "--hero-ascii-scene-opacity",
        String(sceneOpacity),
      );
      const landscapeProgress = smoothStep(
        clampUnit(
          (elapsed - ASCII_ENTRANCE_LANDSCAPE_START) /
            (ASCII_ENTRANCE_END - ASCII_ENTRANCE_LANDSCAPE_START),
        ),
      );
      if (landscapeProgress > 0.001) {
        context.save();
        context.globalAlpha = landscapeProgress;
        context.drawImage(finalSceneCanvas, 0, 0, displayWidth, displayHeight);
        context.restore();
      }

      let renderedGlyphs = 0;
      for (const entranceCell of entranceCells) {
        const localRingProgress = easeOutCubic(
          clampUnit(
            (ringProgress - entranceCell.delay) /
              Math.max(0.01, 1 - entranceCell.delay),
          ),
        );
        if (localRingProgress <= 0.001) continue;
        const ringX = interpolate(
          entranceCenterX,
          entranceCell.ringX,
          localRingProgress,
        );
        const ringY = interpolate(
          entranceCenterY,
          entranceCell.ringY,
          localRingProgress,
        );
        const x = interpolate(ringX, entranceCell.cell.x, morphProgress);
        const y = interpolate(ringY, entranceCell.cell.y, morphProgress);
        const rotation = entranceCell.rotation * (1 - morphProgress);
        const alpha =
          interpolate(
            Math.min(0.94, 0.18 + localRingProgress * 0.76),
            entranceCell.cell.alpha,
            morphProgress,
          ) *
          (1 - landscapeProgress);
        if (alpha <= 0.001) continue;
        const glyphIndex = Math.min(
          ASCII_CHARACTERS.length - 1,
          Math.max(
            1,
            entranceCell.cell.glyphIndex +
              Math.round((1 - morphProgress) * entranceCell.cell.glyphDrift),
          ),
        );
        context.fillStyle = `rgb(${entranceCell.cell.red} ${entranceCell.cell.green} ${entranceCell.cell.blue} / ${alpha})`;
        drawRotatedGlyph(ASCII_CHARACTERS[glyphIndex], x, y, rotation);
        renderedGlyphs += 1;
      }

      if (elapsed >= ASCII_ENTRANCE_END) {
        entranceStarted = false;
        entranceCells = [];
        settleAsciiEntrance(root, "played");
      }

      return renderedGlyphs;
    };

    const renderFrame = (time: number, force = false) => {
      if (
        entranceStarted &&
        !force &&
        time - lastFrameTime < ASCII_ENTRANCE_FRAME_INTERVAL
      ) {
        window.requestAnimationFrame(renderFrame);
        return;
      }
      lastFrameTime = time;
      context.clearRect(0, 0, displayWidth, displayHeight);

      const fontFamily = getComputedStyle(element)
        .getPropertyValue("--font-mono")
        .trim();
      context.font = `${ASCII_CELL_SIZE * 0.88}px ${fontFamily}`;
      context.textAlign = "center";
      context.textBaseline = "middle";
      if (entranceStarted) {
        const renderedGlyphs = drawEntranceFrame(time, fontFamily);
        element.dataset.asciiGlyphCount = String(renderedGlyphs);
        if (entranceStarted) {
          window.requestAnimationFrame(renderFrame);
        } else {
          window.requestAnimationFrame((nextTime) =>
            renderFrame(nextTime, true),
          );
        }
        return;
      }

      context.drawImage(finalSceneCanvas, 0, 0, displayWidth, displayHeight);
      element.dataset.asciiGlyphCount = String(cells.length);
      startGlyphMotion();
    };

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      glyphMotionVisible = entry.isIntersecting;
      if (glyphMotionVisible) startGlyphMotion();
      else stopGlyphMotion();
    });
    visibilityObserver.observe(element);
    root.addEventListener("hero-ascii-ready", startGlyphMotion);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopGlyphMotion();
      else startGlyphMotion();
    });
    motionPreference.addEventListener("change", () => {
      if (motionPreference.matches) stopGlyphMotion();
      else startGlyphMotion();
    });

    const scheduleBuild = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(buildCells, 120);
    };

    const start = () => {
      buildCells();
    };

    const resizeObserver = new ResizeObserver(scheduleBuild);
    resizeObserver.observe(element);
    window.addEventListener("resize", scheduleBuild, { passive: true });

    const themeObserver = new MutationObserver(() => {
      buildCells();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });

    const decodeAndStart = async () => {
      try {
        await sourceImage.decode();
      } catch {
        if (!sourceImage.complete || sourceImage.naturalWidth <= 0) {
          settleAsciiEntrance(root, "image-decode-failed");
          return;
        }
      }

      imageDecoded = true;
      start();
    };

    if (root.dataset.asciiEntranceState === "armed") {
      entranceFallbackTimer = window.setTimeout(() => {
        if (root.dataset.asciiEntranceState === "armed") {
          settleAsciiEntrance(root, "initialization-timeout");
        }
      }, 5500);
    }

    if (sourceImage.complete && sourceImage.naturalWidth > 0) {
      void decodeAndStart();
    } else {
      sourceImage.addEventListener("load", () => void decodeAndStart(), {
        once: true,
      });
      sourceImage.addEventListener(
        "error",
        () => settleAsciiEntrance(root, "image-load-failed"),
        { once: true },
      );
    }
  });
</script>
