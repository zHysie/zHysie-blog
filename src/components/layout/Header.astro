---
import { Icon } from "astro-icon/components";
import type { Locale } from "../../lib/site-config";
import { t } from "../../i18n/ui";
import { resolveRoute, detectLocale, stripLocale } from "../../i18n/routes";
import { mainNav } from "../../config/nav.config";
import { siteConfig } from "../../config/site.config";
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  currentLocale: Locale;
  currentPath?: string;
  showThemeToggle?: boolean;
}

const {
  currentLocale,
  currentPath = "/",
  showThemeToggle = true,
} = Astro.props as Props;
const detectedLocale = detectLocale(currentPath);
const effectiveLocale = detectedLocale || currentLocale;
const contentPath = stripLocale(currentPath);

const navLinks = mainNav.map((item) => ({
  ...item,
  href: resolveRoute(effectiveLocale, item.href),
  active: contentPath === item.href,
  flipId: item.href === "/" ? "home" : item.href.slice(1).replaceAll("/", "-"),
}));

const githubUrl = siteConfig.socialLinks.find(
  (link) => link.platform === "github",
)?.url;
const hasAlternateLocale = siteConfig.i18n.locales.some(
  (locale) => locale !== effectiveLocale,
);
const revealNavigationOnScroll = contentPath === "/";
---

<header
  class="header nav-top"
  data-header
  data-nav-state="top"
  data-nav-threshold="96"
  data-scroll-reveal={revealNavigationOnScroll ? "" : undefined}
>
  <div
    class="header__frame"
    data-nav-frame
    data-nav-flip
    data-flip-id="nav-frame"
  >
    <div class="header__bar container">
      <div
        class="header__logo"
        data-tooltip={siteConfig.name}
        data-nav-flip
        data-flip-id="nav-logo"
      >
        <Logo href={resolveRoute(effectiveLocale, "/")} />
      </div>

      <nav
        class="header__desktop-nav"
        aria-label={t(effectiveLocale, "nav.home")}
      >
        <ul class="header__list">
          {
            navLinks.map((item) => (
              <li
                class={`header__item ${item.children?.length ? "header__item--group" : ""}`}
              >
                {item.children?.length ? (
                  <div class="header__dropdown">
                    <a
                      href={item.href}
                      aria-label={t(effectiveLocale, item.labelKey)}
                      aria-current={item.active ? "page" : undefined}
                      data-nav-flip
                      data-flip-id={`nav-${item.flipId}`}
                    >
                      <Icon
                        name={item.icon ?? "lucide:circle"}
                        class="header__item-icon"
                        aria-hidden="true"
                      />
                      <span class="header__item-label">
                        {t(effectiveLocale, item.labelKey)}
                      </span>
                    </a>
                    <div class="header__dropdown-panel">
                      {item.children.map((child) => (
                        <a href={resolveRoute(effectiveLocale, child.href)}>
                          {t(effectiveLocale, child.labelKey)}
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <a
                    href={item.href}
                    aria-label={t(effectiveLocale, item.labelKey)}
                    aria-current={item.active ? "page" : undefined}
                    data-nav-flip
                    data-flip-id={`nav-${item.flipId}`}
                  >
                    <Icon
                      name={item.icon ?? "lucide:circle"}
                      class="header__item-icon"
                      aria-hidden="true"
                    />
                    <span class="header__item-label">
                      {t(effectiveLocale, item.labelKey)}
                    </span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header__actions">
        {
          githubUrl && (
            <div
              class="header__utility"
              data-tooltip="GitHub"
              data-nav-flip
              data-flip-id="nav-github"
            >
              <a
                href={githubUrl}
                class="header__icon-button header__github"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
              >
                <Icon
                  name="simple-icons:github"
                  class="header__icon"
                  aria-hidden="true"
                />
              </a>
            </div>
          )
        }

        <div
          class="header__utility"
          data-tooltip={t(effectiveLocale, "aria.searchButton")}
          data-nav-flip
          data-flip-id="nav-search"
        >
          <button
            type="button"
            class="header__icon-button header__search"
            data-search-trigger
            aria-label={t(effectiveLocale, "aria.searchButton")}
          >
            <Icon
              name="lucide:search"
              class="header__icon"
              aria-hidden="true"
            />
            <kbd class="header__kbd">⌘K</kbd>
          </button>
        </div>

        {
          hasAlternateLocale && (
            <div
              class="header__utility"
              data-tooltip="Language"
              data-nav-flip
              data-flip-id="nav-language"
            >
              <LanguageSwitcher
                currentLocale={effectiveLocale}
                currentPath={currentPath}
              />
            </div>
          )
        }

        {
          showThemeToggle && (
            <div
              class="header__utility"
              data-tooltip={t(effectiveLocale, "nav.darkMode")}
              data-nav-flip
              data-flip-id="nav-theme"
            >
              <ThemeToggle locale={effectiveLocale} />
            </div>
          )
        }

        <button
          type="button"
          class="header__icon-button header__menu-button"
          data-menu-toggle
          aria-controls="header-mobile-menu"
          aria-expanded="false"
          aria-label={t(effectiveLocale, "nav.toggleMenu")}
        >
          <Icon
            name="lucide:menu"
            class="header__icon header__icon--menu"
            aria-hidden="true"
          />
          <Icon
            name="lucide:x"
            class="header__icon header__icon--close"
            aria-hidden="true"
          />
        </button>
      </div>
    </div>
  </div>

  <div id="header-mobile-menu" class="header__mobile" data-menu-panel hidden>
    <nav aria-label={t(effectiveLocale, "nav.home")}>
      <ul class="header__mobile-list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
              >
                {t(effectiveLocale, item.labelKey)}
              </a>
              {item.children?.length && (
                <ul class="header__mobile-sublist">
                  {item.children.map((child) => (
                    <li>
                      <a href={resolveRoute(effectiveLocale, child.href)}>
                        {t(effectiveLocale, child.labelKey)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  const header = document.querySelector<HTMLElement>("[data-header]");
  const menuToggle =
    header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menuPanel = header?.querySelector<HTMLElement>("[data-menu-panel]");

  if (header && menuToggle && menuPanel) {
    const syncMenu = (open: boolean) => {
      menuToggle.setAttribute("aria-expanded", String(open));
      menuPanel.hidden = !open;
      header.toggleAttribute("data-menu-open", open);
    };

    menuToggle.addEventListener("click", () => {
      syncMenu(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") syncMenu(false);
    });
  }

  if (header) {
    const root = document.documentElement;
    const threshold = Number(header.dataset.navThreshold ?? 96);
    const flipTargets = Array.from(
      header.querySelectorAll<HTMLElement>("[data-nav-flip]"),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const revealOnScroll = header.hasAttribute("data-scroll-reveal");
    const media = gsap.matchMedia();

    media.add("(min-width: 60.0625rem)", () => {
      let railActive: boolean | null = null;
      let scrollFrame = 0;
      let dockFrame = 0;
      let pointerY = 0;
      let currentFlip: ReturnType<typeof Flip.from> | null = null;
      let currentReveal: gsap.core.Timeline | null = null;
      let dockResetCall: gsap.core.Tween | null = null;
      let brandResizeFrame = 0;
      const dock = header.querySelector<HTMLElement>(".header__list");
      const heroBrandSource = document.querySelector<HTMLImageElement>(
        "[data-hero-brand-mark]",
      );
      const headerBrandTarget =
        header.querySelector<HTMLImageElement>(".logo__mark-image");
      const brandFlightDistance = 260;
      const brandXAxisEase = gsap.parseEase("power1.inOut");
      const brandYAxisEase = gsap.parseEase("power2.inOut");
      const brandScaleEase = gsap.parseEase("power2.inOut");
      let brandFlight: HTMLImageElement | null = null;
      let brandStart: {
        left: number;
        top: number;
        width: number;
        height: number;
      } | null = null;
      let brandEnd: {
        left: number;
        top: number;
        width: number;
        height: number;
      } | null = null;
      const dockLinks = Array.from(
        header.querySelectorAll<HTMLElement>(
          ".header__item > a, .header__dropdown > a",
        ),
      );
      const dockMotion = dockLinks.map((item) => ({
        item,
        shell: item.closest<HTMLElement>(".header__item") ?? item,
      }));

      const measureBrandFlight = () => {
        if (!heroBrandSource || !headerBrandTarget) return;

        const sourceRect = heroBrandSource.getBoundingClientRect();
        const sourceWidth = heroBrandSource.offsetWidth;
        const sourceHeight = heroBrandSource.offsetHeight;
        brandStart = {
          left: sourceRect.left + (sourceRect.width - sourceWidth) / 2,
          top:
            sourceRect.top +
            window.scrollY +
            (sourceRect.height - sourceHeight) / 2,
          width: sourceWidth,
          height: sourceHeight,
        };

        const previousClassName = header.className;
        if (!header.classList.contains("nav-left")) {
          header.classList.remove("nav-top", "nav-hidden");
          header.classList.add("nav-left");
        }
        const targetRect = headerBrandTarget.getBoundingClientRect();
        brandEnd = {
          left: targetRect.left,
          top: targetRect.top,
          width: targetRect.width,
          height: targetRect.height,
        };
        header.className = previousClassName;

        if (!brandFlight && !reducedMotion.matches) {
          brandFlight = heroBrandSource.cloneNode(false) as HTMLImageElement;
          brandFlight.removeAttribute("data-hero-brand-mark");
          brandFlight.className = "header__brand-flight";
          brandFlight.setAttribute("aria-hidden", "true");
          document.body.append(brandFlight);
          heroBrandSource.style.visibility = "hidden";
          header.toggleAttribute("data-brand-flight", true);
        }

        if (brandFlight) {
          gsap.set(brandFlight, {
            left: brandStart.left,
            top: brandStart.top,
            width: brandStart.width,
            height: brandStart.height,
          });
        }
      };

      const syncBrandFlight = () => {
        if (!brandFlight || !brandStart || !brandEnd) return;

        const progress = Math.min(
          Math.max(window.scrollY / brandFlightDistance, 0),
          1,
        );
        const flightPose = Math.sin(Math.PI * progress);
        const settleProgress = Math.min(
          Math.max((progress - 0.72) / 0.28, 0),
          1,
        );
        const settlePulse = Math.sin(Math.PI * settleProgress);
        const xProgress = brandXAxisEase(progress) + settlePulse * 0.05;
        const yProgress = brandYAxisEase(progress) + settlePulse * 0.018;
        const scaleProgress = brandScaleEase(progress);
        const targetScale = brandEnd.width / brandStart.width;

        gsap.set(brandFlight, {
          x: (brandEnd.left - brandStart.left) * xProgress,
          y: (brandEnd.top - brandStart.top) * yProgress - flightPose * 14,
          scale: 1 + (targetScale - 1) * scaleProgress - settlePulse * 0.012,
          rotation: flightPose * -5.5 + settlePulse * 1.2,
          force3D: true,
        });
      };

      const onBrandResize = () => {
        if (brandResizeFrame) return;
        brandResizeFrame = window.requestAnimationFrame(() => {
          brandResizeFrame = 0;
          measureBrandFlight();
          syncBrandFlight();
        });
      };

      const resetDockMotion = (animate = true) => {
        if (dockFrame) {
          window.cancelAnimationFrame(dockFrame);
          dockFrame = 0;
        }
        if (dockResetCall) {
          dockResetCall.kill();
          dockResetCall = null;
        }

        dockMotion.forEach(({ item }) => {
          item.style.setProperty("--dock-scale", "1");
          item.style.setProperty("--dock-x", "0px");
          item.style.setProperty("--dock-y", "0px");
          item.style.zIndex = "";
        });

        if (!animate || reducedMotion.matches) {
          dockLinks.forEach((item) => {
            item.style.removeProperty("--dock-scale");
            item.style.removeProperty("--dock-x");
            item.style.removeProperty("--dock-y");
            item.style.removeProperty("transform-origin");
            item.style.removeProperty("will-change");
            item.style.removeProperty("z-index");
          });
          return;
        }

        dockResetCall = gsap.delayedCall(0.28, () => {
          dockLinks.forEach((item) => {
            item.style.removeProperty("--dock-scale");
            item.style.removeProperty("--dock-x");
            item.style.removeProperty("--dock-y");
            item.style.removeProperty("will-change");
            item.style.removeProperty("z-index");
          });
          dockResetCall = null;
        });
      };

      const updateDockMagnification = () => {
        dockFrame = 0;
        if (
          reducedMotion.matches ||
          header.dataset.navState !== "rail" ||
          header.hasAttribute("data-nav-animating")
        ) {
          resetDockMotion(false);
          return;
        }

        const influenceRadius = 116;
        const maximumScale = 1.46;

        dockMotion.forEach(({ item, shell }) => {
          const rect = shell.getBoundingClientRect();
          const distance = pointerY - (rect.top + rect.height / 2);
          const proximity = Math.max(
            0,
            1 - Math.abs(distance) / influenceRadius,
          );
          const curve = 0.5 - 0.5 * Math.cos(Math.PI * proximity);

          item.style.setProperty(
            "--dock-scale",
            String(1 + (maximumScale - 1) * curve),
          );
          item.style.setProperty("--dock-x", `${curve * 5}px`);
          item.style.setProperty(
            "--dock-y",
            `${-Math.sign(distance) * curve * 5}px`,
          );
          item.style.zIndex = String(Math.round(curve * 10));
        });
      };

      const onDockPointerEnter = () => {
        if (reducedMotion.matches) return;
        if (dockResetCall) {
          dockResetCall.kill();
          dockResetCall = null;
        }
        dockLinks.forEach((item) => {
          item.style.transformOrigin = "left center";
          item.style.willChange = "transform";
        });
      };

      const onDockPointerMove = (event: PointerEvent) => {
        pointerY = event.clientY;
        if (!dockFrame) {
          dockFrame = window.requestAnimationFrame(updateDockMagnification);
        }
      };

      const onDockPointerLeave = () => resetDockMotion();

      const clearRevealStyles = () => {
        gsap.set(flipTargets, {
          clearProps: "opacity,visibility,transform",
        });
        header.removeAttribute("data-nav-animating");
      };

      const applyState = (nextRail: boolean, animate = true) => {
        if (nextRail === railActive) return;

        if (heroBrandSource && !brandFlight) {
          heroBrandSource.style.visibility = nextRail ? "hidden" : "";
        }

        if (currentFlip) {
          currentFlip.progress(1).kill();
          currentFlip = null;
        }
        if (currentReveal) {
          currentReveal.kill();
          currentReveal = null;
        }
        Flip.killFlipsOf(flipTargets, true);

        if (revealOnScroll) {
          railActive = nextRail;
          header.dataset.navState = nextRail ? "rail" : "hidden";
          root.toggleAttribute("data-nav-layout", nextRail);

          if (!nextRail) {
            resetDockMotion(false);
            header.classList.remove("nav-top", "nav-left");
            header.classList.add("nav-hidden");
            clearRevealStyles();
            return;
          }

          header.classList.remove("nav-top", "nav-hidden");
          header.classList.add("nav-left");

          if (!animate || reducedMotion.matches) {
            clearRevealStyles();
            return;
          }

          const frame = flipTargets[0];
          const items = flipTargets.slice(1);
          const finishReveal = () => {
            currentReveal = null;
            clearRevealStyles();
          };

          header.toggleAttribute("data-nav-animating", true);
          currentReveal = gsap.timeline({
            onComplete: finishReveal,
            onInterrupt: () => {
              currentReveal = null;
              clearRevealStyles();
            },
          });

          currentReveal
            .fromTo(
              frame,
              { autoAlpha: 0, x: -12, scale: 0.985 },
              {
                autoAlpha: 1,
                x: 0,
                scale: 1,
                duration: 0.42,
                ease: "power3.out",
              },
              0,
            )
            .fromTo(
              items,
              { autoAlpha: 0, x: -8 },
              {
                autoAlpha: 1,
                x: 0,
                duration: 0.3,
                ease: "power3.out",
                stagger: 0.018,
              },
              0.06,
            );
          return;
        }

        const state =
          animate && !reducedMotion.matches ? Flip.getState(flipTargets) : null;

        railActive = nextRail;
        header.classList.toggle("nav-left", nextRail);
        header.classList.toggle("nav-top", !nextRail);
        header.dataset.navState = nextRail ? "rail" : "top";
        root.toggleAttribute("data-nav-layout", nextRail);

        if (!state) return;

        header.toggleAttribute("data-nav-animating", true);
        currentFlip = Flip.from(state, {
          targets: flipTargets,
          duration: 0.56,
          ease: "power3.inOut",
          absolute: false,
          nested: true,
          scale: true,
          stagger: 0.012,
          onComplete: () => {
            currentFlip = null;
            header.removeAttribute("data-nav-animating");
          },
          onInterrupt: () => {
            currentFlip = null;
            header.removeAttribute("data-nav-animating");
          },
        });
      };

      const syncFromScroll = (animate = true) => {
        syncBrandFlight();
        applyState(window.scrollY > threshold, animate);
        scrollFrame = 0;
      };

      const onScroll = () => {
        if (!scrollFrame) {
          scrollFrame = window.requestAnimationFrame(() => syncFromScroll());
        }
      };

      measureBrandFlight();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onBrandResize, { passive: true });
      dock?.addEventListener("pointerenter", onDockPointerEnter);
      dock?.addEventListener("pointermove", onDockPointerMove, {
        passive: true,
      });
      dock?.addEventListener("pointerleave", onDockPointerLeave);
      dock?.addEventListener("pointercancel", onDockPointerLeave);
      syncFromScroll(false);

      return () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onBrandResize);
        dock?.removeEventListener("pointerenter", onDockPointerEnter);
        dock?.removeEventListener("pointermove", onDockPointerMove);
        dock?.removeEventListener("pointerleave", onDockPointerLeave);
        dock?.removeEventListener("pointercancel", onDockPointerLeave);
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (brandResizeFrame) window.cancelAnimationFrame(brandResizeFrame);
        resetDockMotion(false);
        if (currentFlip) currentFlip.kill();
        if (currentReveal) currentReveal.kill();
        Flip.killFlipsOf(flipTargets, true);
        clearRevealStyles();
        header.classList.remove("nav-left", "nav-hidden");
        header.classList.add("nav-top");
        header.dataset.navState = "top";
        header.removeAttribute("data-nav-animating");
        header.removeAttribute("data-brand-flight");
        brandFlight?.remove();
        heroBrandSource?.style.removeProperty("visibility");
        root.removeAttribute("data-nav-layout");
      };
    });
  }
</script>

<style>
  .header {
    --nav-rail-width: var(--header-height-mobile);
    --nav-control-size: calc(var(--header-height-mobile) - var(--space-md));
    position: sticky;
    top: 0;
    z-index: var(--z-index-sticky);
    height: var(--header-height);
    pointer-events: none;
  }

  .header__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-primary) 86%, transparent);
    backdrop-filter: blur(0.75rem) saturate(1.15);
    pointer-events: auto;
  }

  :global(.header__brand-flight) {
    position: fixed;
    z-index: calc(var(--z-index-sticky) + 1);
    display: block;
    margin: 0;
    object-fit: contain;
    pointer-events: none;
    transform-origin: top left;
    will-change: transform;
  }

  .header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 100%;
  }

  .header__logo {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .header :global(.logo) {
    position: relative;
    transform-origin: left center;
  }

  .header :global(.logo__name),
  .header :global(.logo__mark) {
    transition:
      opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0s;
  }

  .header.nav-top :global(.logo__name) {
    visibility: visible;
    opacity: 1;
  }

  .header.nav-top :global(.logo__mark) {
    visibility: visible;
    opacity: 0;
  }

  .header__desktop-nav {
    flex: 1;
  }

  .header__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__item,
  .header__dropdown {
    position: relative;
  }

  .header__item > a,
  .header__dropdown > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--nav-control-size);
    padding: 0.4rem 0.65rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    transition:
      color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header__item > a::after,
  .header__dropdown > a::after {
    position: absolute;
    right: 0.65rem;
    bottom: 0.15rem;
    left: 0.65rem;
    height: 1px;
    background: var(--color-text-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header__item > a:hover,
  .header__dropdown > a:hover {
    color: var(--color-text-primary);
  }

  .header__item > a:hover::after,
  .header__item > a:focus-visible::after,
  .header__dropdown > a:hover::after,
  .header__dropdown > a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .header__item > a[aria-current="page"],
  .header__dropdown > a[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .header__item-icon {
    position: absolute;
    width: 1.125rem;
    height: 1.125rem;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.72);
    flex: 0 0 auto;
    transition:
      opacity 0.18s ease,
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header__item-label {
    display: inline-block;
  }

  .header__dropdown-panel {
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: 0;
    display: none;
    min-width: 12rem;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
