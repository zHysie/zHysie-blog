---
import { Icon } from "astro-icon/components";
import type { Locale } from "../../lib/site-config";
import { t } from "../../i18n/ui";
import { resolveRoute, detectLocale, stripLocale } from "../../i18n/routes";
import { mainNav } from "../../config/nav.config";
import { siteConfig } from "../../config/site.config";
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  currentLocale: Locale;
  currentPath?: string;
  showThemeToggle?: boolean;
}

const {
  currentLocale,
  currentPath = "/",
  showThemeToggle = true,
} = Astro.props as Props;
const detectedLocale = detectLocale(currentPath);
const effectiveLocale = detectedLocale || currentLocale;
const contentPath = stripLocale(currentPath);

const navLinks = mainNav.map((item) => ({
  ...item,
  href: resolveRoute(effectiveLocale, item.href),
  active: contentPath === item.href,
  flipId: item.href === "/" ? "home" : item.href.slice(1).replaceAll("/", "-"),
}));

const githubUrl = siteConfig.socialLinks.find(
  (link) => link.platform === "github",
)?.url;
const hasAlternateLocale = siteConfig.i18n.locales.some(
  (locale) => locale !== effectiveLocale,
);
const revealNavigationOnScroll = contentPath === "/";
---

<header
  class="header nav-top"
  data-header
  data-nav-state="top"
  data-nav-threshold="96"
  data-scroll-reveal={revealNavigationOnScroll ? "" : undefined}
>
  <div
    class="header__frame"
    data-nav-frame
    data-nav-flip
    data-flip-id="nav-frame"
  >
    <div class="header__bar container">
      <div
        class="header__logo"
        data-tooltip={siteConfig.name}
        data-nav-flip
        data-flip-id="nav-logo"
      >
        <Logo href={resolveRoute(effectiveLocale, "/")} />
      </div>

      <nav
        class="header__desktop-nav"
        aria-label={t(effectiveLocale, "nav.home")}
      >
        <ul class="header__list">
          {
            navLinks.map((item) => (
              <li
                class={`header__item ${item.children?.length ? "header__item--group" : ""}`}
              >
                {item.children?.length ? (
                  <div class="header__dropdown">
                    <a
                      href={item.href}
                      aria-label={t(effectiveLocale, item.labelKey)}
                      aria-current={item.active ? "page" : undefined}
                      data-nav-flip
                      data-flip-id={`nav-${item.flipId}`}
                    >
                      <Icon
                        name={item.icon ?? "lucide:circle"}
                        class="header__item-icon"
                        aria-hidden="true"
                      />
                      <span class="header__item-label">
                        {t(effectiveLocale, item.labelKey)}
                      </span>
                    </a>
                    <div class="header__dropdown-panel">
                      {item.children.map((child) => (
                        <a href={resolveRoute(effectiveLocale, child.href)}>
                          {t(effectiveLocale, child.labelKey)}
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <a
                    href={item.href}
                    aria-label={t(effectiveLocale, item.labelKey)}
                    aria-current={item.active ? "page" : undefined}
                    data-nav-flip
                    data-flip-id={`nav-${item.flipId}`}
                  >
                    <Icon
                      name={item.icon ?? "lucide:circle"}
                      class="header__item-icon"
                      aria-hidden="true"
                    />
                    <span class="header__item-label">
                      {t(effectiveLocale, item.labelKey)}
                    </span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header__actions">
        {
          githubUrl && (
            <div
              class="header__utility"
              data-tooltip="GitHub"
              data-nav-flip
              data-flip-id="nav-github"
            >
              <a
                href={githubUrl}
                class="header__icon-button header__github"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
              >
                <Icon
                  name="simple-icons:github"
                  class="header__icon"
                  aria-hidden="true"
                />
              </a>
            </div>
          )
        }

        <div
          class="header__utility"
          data-tooltip={t(effectiveLocale, "aria.searchButton")}
          data-nav-flip
          data-flip-id="nav-search"
        >
          <button
            type="button"
            class="header__icon-button header__search"
            data-search-trigger
            aria-label={t(effectiveLocale, "aria.searchButton")}
          >
            <Icon
              name="lucide:search"
              class="header__icon"
              aria-hidden="true"
            />
            <kbd class="header__kbd">⌘K</kbd>
          </button>
        </div>

        {
          hasAlternateLocale && (
            <div
              class="header__utility"
              data-tooltip="Language"
              data-nav-flip
              data-flip-id="nav-language"
            >
              <LanguageSwitcher
                currentLocale={effectiveLocale}
                currentPath={currentPath}
              />
            </div>
          )
        }

        {
          showThemeToggle && (
            <div
              class="header__utility"
              data-tooltip={t(effectiveLocale, "nav.darkMode")}
              data-nav-flip
              data-flip-id="nav-theme"
            >
              <ThemeToggle locale={effectiveLocale} />
            </div>
          )
        }

        <button
          type="button"
          class="header__icon-button header__menu-button"
          data-menu-toggle
          aria-controls="header-mobile-menu"
          aria-expanded="false"
          aria-label={t(effectiveLocale, "nav.toggleMenu")}
        >
          <Icon
            name="lucide:menu"
            class="header__icon header__icon--menu"
            aria-hidden="true"
          />
          <Icon
            name="lucide:x"
            class="header__icon header__icon--close"
            aria-hidden="true"
          />
        </button>
      </div>
    </div>
  </div>

  <div id="header-mobile-menu" class="header__mobile" data-menu-panel hidden>
    <nav aria-label={t(effectiveLocale, "nav.home")}>
      <ul class="header__mobile-list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
              >
                {t(effectiveLocale, item.labelKey)}
              </a>
              {item.children?.length && (
                <ul class="header__mobile-sublist">
                  {item.children.map((child) => (
                    <li>
                      <a href={resolveRoute(effectiveLocale, child.href)}>
                        {t(effectiveLocale, child.labelKey)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menuToggle =
    header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menuPanel = header?.querySelector<HTMLElement>("[data-menu-panel]");

  if (header && menuToggle && menuPanel) {
    const syncMenu = (open: boolean) => {
      menuToggle.setAttribute("aria-expanded", String(open));
      menuPanel.hidden = !open;
      header.toggleAttribute("data-menu-open", open);
    };

    menuToggle.addEventListener("click", () => {
      syncMenu(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") syncMenu(false);
    });
  }

  // Scroll Animation Logic
  if (header) {
    const logo = header.querySelector<HTMLElement>(".header__logo");
    let lastScrollY = window.scrollY;
    let ticking = false;
    let isHidden = false;

    const updateLogoOffset = () => {
      if (!logo) return;
      const wasHidden = isHidden;
      if (wasHidden) header.classList.remove("is-scrolling-down");
      
      const rect = logo.getBoundingClientRect();
      
      // 添加微距边缘留白：左侧 4px，顶部 4px
      const safePaddingLeft = 4;
      const safePaddingTop = 4;
      
      header.style.setProperty("--logo-offset-x", `-${rect.left - safePaddingLeft}px`);
      header.style.setProperty("--logo-offset-y", `-${rect.top - safePaddingTop}px`);
      
      if (wasHidden) header.classList.add("is-scrolling-down");
    };

    const updateHeader = () => {
      const currentScrollY = window.scrollY;
      
      if (currentScrollY > 60) {
        if (currentScrollY > lastScrollY && !isHidden) {
          isHidden = true;
          header.classList.add("is-scrolling-down");
        } else if (currentScrollY < lastScrollY && isHidden) {
          isHidden = false;
          header.classList.remove("is-scrolling-down");
        }
      } else if (currentScrollY <= 60 && isHidden) {
        isHidden = false;
        header.classList.remove("is-scrolling-down");
      }
      
      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener("resize", () => {
      window.requestAnimationFrame(updateLogoOffset);
    }, { passive: true });
    
    // Initial calculation
    setTimeout(updateLogoOffset, 50);
  }
</script>

<style>
  .header {
    --nav-rail-width: var(--header-height-mobile);
    --nav-control-size: calc(var(--header-height-mobile) - var(--space-md));
    position: sticky;
    top: 0;
    z-index: var(--z-index-sticky);
    height: var(--header-height);
    pointer-events: none;
  }

  .header__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-primary) 86%, transparent);
    backdrop-filter: blur(0.75rem) saturate(1.15);
    pointer-events: auto;
    transition: 
      background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Scroll Down States */
  .header.is-scrolling-down .header__frame {
    background-color: transparent !important;
    border-bottom-color: transparent !important;
    backdrop-filter: none !important;
  }

  .header.is-scrolling-down .header__desktop-nav,
  .header.is-scrolling-down .header__actions,
  .header.is-scrolling-down .header__menu-button {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-20px);
  }

  .header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 100%;
  }

  .header__logo {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    transform-origin: top left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header.is-scrolling-down .header__logo {
    transform: translate(var(--logo-offset-x, 0), var(--logo-offset-y, 0));
  }

  .header :global(.logo) {
    position: relative;
    transform-origin: left center;
  }

  .header :global(.logo__name),
  .header :global(.logo__mark) {
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0s;
  }

  .header.nav-top :global(.logo__name) {
    visibility: visible;
    opacity: 1;
  }

  .header.nav-top :global(.logo__mark) {
    visibility: visible;
    opacity: 0;
  }

  .header.is-scrolling-down :global(.logo__name) {
    opacity: 0 !important;
  }

  .header.is-scrolling-down :global(.logo__mark) {
    opacity: 1 !important;
  }

  .header__desktop-nav {
    flex: 1;
    transition: 
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__item,
  .header__dropdown {
    position: relative;
  }

  .header__item > a,
  .header__dropdown > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--nav-control-size);
    padding: 0.4rem 0.65rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    transition:
      color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header__item > a::after,
  .header__dropdown > a::after {
    position: absolute;
    right: 0.65rem;
    bottom: 0.15rem;
    left: 0.65rem;
    height: 1px;
    background: var(--color-text-primary);
    content: "";
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header__item > a:hover,
  .header__dropdown > a:hover {
    color: var(--color-text-primary);
  }

  .header__item > a:active,
  .header__dropdown > a:active {
    transform: scale(0.97);
  }

  .header__item > a:hover::after,
  .header__item > a:focus-visible::after,
  .header__dropdown > a:hover::after,
  .header__dropdown > a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .header__item > a[aria-current="page"],
  .header__dropdown > a[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .header__item-icon {
    position: absolute;
    width: 1.125rem;
    height: 1.125rem;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.72);
    flex: 0 0 auto;
    transition:
      opacity 160ms ease-out,
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .header__item-label {
    display: inline-block;
  }

  .header__dropdown-panel {
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: 0;
    display: none;
    min-width: 12rem;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-primary);
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(4px) scale(0.96);
    transform-origin: top;
    transition: opacity 200ms ease-out, transform 200ms ease-out, display 200ms ease-out allow-discrete;
  }

  .header__dropdown:hover .header__dropdown-panel,
  .header__dropdown:focus-within .header__dropdown-panel {
    display: flex;
    opacity: 1;
    transform: translateY(0) scale(1);

    @starting-style {
      opacity: 0;
      transform: translateY(4px) scale(0.96);
    }
  }

  .header__dropdown-panel a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .header__dropdown-panel a:hover {
    color: var(--color-text-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex: 0 0 auto;
    transition: 
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header__utility {
    position: relative;
    display: grid;
    place-items: center;
  }

  .header__icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: var(--nav-control-size);
    appearance: none;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-primary);
    padding: 0 0.7rem;
    box-shadow: none;
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header__icon-button:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
  }

  .header__icon-button:active {
    background: var(--color-bg-tertiary);
    transform: scale(0.97);
  }

  .header__search {
    padding-inline: 0.35rem;
  }

  .header__github {
    width: var(--nav-control-size);
    padding-inline: 0;
  }

  .header__github .header__icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .header__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .header__kbd {
    border: 0;
    background: transparent;
    color: var(--color-text-secondary);
    padding: 0;
    font: inherit;
    font-size: var(--text-xs);
  }

  .header__menu-button {
    display: none;
    width: var(--nav-control-size);
    padding-inline: 0;
  }

  .header__icon--close {
    display: none;
  }

  .header__menu-button[aria-expanded="true"] .header__icon--menu {
    display: none;
  }

  .header__menu-button[aria-expanded="true"] .header__icon--close {
    display: inline-block;
  }

  .header__mobile {
    display: none;
    padding-inline: var(--section-px);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    pointer-events: auto;
  }

  .header__mobile-list,
  .header__mobile-sublist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__mobile-list {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-md) 0;
  }

  .header__mobile-list a {
    display: block;
    padding: 0.6rem 0.5rem;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .header__mobile-list a:hover {
    background: var(--color-bg-tertiary);
  }

  .header__mobile-list a[aria-current="page"] {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
  }

  .header__mobile-sublist {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    padding-left: var(--space-md);
  }

  @media (max-width: 60rem) {
    .header__desktop-nav {
      display: none;
    }

    .header__menu-button {
      display: inline-flex;
    }

    .header__mobile:not([hidden]) {
      display: block;
    }
  }

  @media (max-width: 26rem) {
    .header.nav-top :global(.logo__mark) {
      opacity: 1;
    }

    .header__github,
    .header__kbd {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header :global(.logo__name),
    .header :global(.logo__mark),
    .header__item > a,
    .header__dropdown > a,
    .header__item-icon,
    .header__icon-button,
    .header__mobile-list a,
    .header.nav-left .header__item > a::after,
    .header.nav-left .header__dropdown > a::after,
    .header.nav-left .header__utility::after,
    .header.nav-left .header__logo::after,
    :global(#main-content .container),
    :global(.footer__inner) {
      transition: none;
    }
  }
</style>
