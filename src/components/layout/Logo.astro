---
import { siteConfig } from "../../config/site.config";
export interface Props {
  href?: string;
  deferLoading?: boolean;
}

const { href = "/", deferLoading = false } = Astro.props as Props;
---

<a href={href} class="logo" aria-label={siteConfig.name}>
  <span class="logo__mark" aria-hidden="true">
    <img
      class="logo__mark-image"
      src={deferLoading ? undefined : siteConfig.branding.favicon}
      data-home-src={deferLoading ? siteConfig.branding.favicon : undefined}
      alt=""
      width="32"
      height="32"
    />
  </span>
  <span class="logo__name" aria-hidden="true">
    <img
      class="logo__brand-image logo__brand-image--light"
      src={deferLoading ? undefined : siteConfig.branding.logo.light}
      data-home-src={deferLoading ? siteConfig.branding.logo.light : undefined}
      alt=""
      width="76"
      height="40"
    />
    <img
      class="logo__brand-image logo__brand-image--dark"
      src={deferLoading ? undefined : siteConfig.branding.logo.dark}
      data-home-src={deferLoading ? siteConfig.branding.logo.dark : undefined}
      alt=""
      width="76"
      height="40"
    />
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text-primary);
    border-radius: var(--radius-md);
  }

  .logo:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .logo__mark {
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    flex-shrink: 0;
  }

  .logo__mark-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo__name {
    position: relative;
    display: block;
    width: 4.75rem;
    height: 2.5rem;
  }

  .logo__brand-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo__brand-image--dark {
    display: none;
  }

  :global(html.dark) .logo__brand-image--light {
    display: none;
  }

  :global(html.dark) .logo__brand-image--dark {
    display: block;
  }

  /* Keep the brand compact on small screens — monogram remains. */
  @media (max-width: 26rem) {
    .logo__mark {
      position: static;
      opacity: 1;
      transform: none;
    }

    .logo__name {
      display: none;
    }
  }
</style>
