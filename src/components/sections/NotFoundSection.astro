---
import type { Locale } from "../../lib/site-config";
import { resolveRoute } from "../../i18n/routes";
import { t } from "../../i18n/ui";
import { Icon } from "astro-icon/components";
import { Ascii404 } from "../ui";

export interface Props {
  locale?: Locale;
}

const { locale = "zh-CN" } = Astro.props as Props;
---

<section class="not-found" aria-labelledby="not-found-title">
  <div class="not-found__frame container">
    <div class="not-found__content">
      <div class="not-found__status">
        <span class="not-found__status-light" aria-hidden="true"></span>
        <p class="not-found__eyebrow">{t(locale, "notfound.eyebrow")}</p>
        <span class="not-found__status-line" aria-hidden="true"></span>
      </div>
      <h1 id="not-found-title" class="not-found__title">
        {t(locale, "notfound.title")}
      </h1>
      <span class="not-found__rule" aria-hidden="true"></span>
      <p class="not-found__description">{t(locale, "notfound.desc")}</p>
      <nav class="not-found__actions" aria-label={t(locale, "notfound.title")}>
        <a
          class="not-found__action not-found__action--home"
          href={resolveRoute(locale, "/")}
        >
          <Icon name="lucide:arrow-left" size="1rem" aria-hidden="true" />
          <span>{t(locale, "notfound.back")}</span>
        </a>
        <a
          class="not-found__action not-found__action--posts"
          href={resolveRoute(locale, "/posts")}
        >
          <span>{t(locale, "notfound.browse")}</span>
          <Icon name="lucide:arrow-right" size="1rem" aria-hidden="true" />
        </a>
      </nav>
    </div>

    <div class="not-found__visual" aria-hidden="true">
      <span class="not-found__orbit not-found__orbit--outer"></span>
      <span class="not-found__orbit not-found__orbit--inner"></span>
      <span class="not-found__corner not-found__corner--top-left"></span>
      <span class="not-found__corner not-found__corner--top-right"></span>
      <span class="not-found__corner not-found__corner--bottom-left"></span>
      <span class="not-found__corner not-found__corner--bottom-right"></span>
      <Ascii404 />
    </div>
  </div>
</section>

<style>
  .not-found {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    background:
      radial-gradient(
        circle at 72% 43%,
        color-mix(in srgb, var(--brand-logo-blue) 11%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at 84% 61%,
        color-mix(in srgb, var(--brand-logo-pink) 10%, transparent),
        transparent 24%
      );
    color: var(--foreground);
  }

  .not-found__frame {
    display: grid;
    grid-template-rows: auto minmax(22rem, 1fr);
    gap: var(--space-xl);
    min-height: calc(100svh - var(--header-height));
    padding-block: clamp(var(--space-2xl), 8vh, var(--space-3xl));
  }

  .not-found__content {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 36rem;
  }

  .not-found__status {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    animation: not-found-reveal 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .not-found__status-light {
    width: var(--spacing-2);
    height: var(--spacing-2);
    flex: 0 0 auto;
    border-radius: var(--radius-full);
    background: var(--brand-logo-blue);
    box-shadow: 0 0 var(--space-sm)
      color-mix(in srgb, var(--brand-logo-blue) 55%, transparent);
    animation: not-found-pulse 2.4s ease-in-out infinite;
  }

  .not-found__eyebrow {
    flex: 0 0 auto;
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.14em;
  }

  .not-found__status-line {
    position: relative;
    display: block;
    width: clamp(var(--space-2xl), 9vw, var(--spacing-10));
    height: 1px;
    overflow: hidden;
    background: var(--border);
  }

  .not-found__status-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--brand-logo-blue),
      var(--brand-logo-pink)
    );
    transform: translateX(-100%);
    animation: not-found-scan 2.8s cubic-bezier(0.16, 1, 0.3, 1) 500ms infinite;
  }

  .not-found__title {
    max-width: none;
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-cjk-serif);
    font-size: clamp(2.5rem, 4.2vw, 4.25rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: 1.06;
    white-space: nowrap;
    animation: not-found-title-reveal 680ms cubic-bezier(0.16, 1, 0.3, 1) 90ms
      both;
  }

  .not-found__rule {
    display: block;
    width: var(--space-2xl);
    height: 1px;
    margin-block: var(--space-xl);
    background: linear-gradient(
      90deg,
      var(--brand-logo-blue) 0 46%,
      transparent 46% 54%,
      var(--brand-logo-pink) 54%
    );
    transform-origin: left;
    animation: not-found-rule-in 560ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
  }

  .not-found__description {
    max-width: 29rem;
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-cjk-sans);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    animation: not-found-reveal 560ms cubic-bezier(0.16, 1, 0.3, 1) 290ms both;
  }

  .not-found__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 25rem);
    margin-top: var(--space-2xl);
    border-block: 1px solid var(--border);
    animation: not-found-reveal 560ms cubic-bezier(0.16, 1, 0.3, 1) 380ms both;
  }

  .not-found__action {
    --not-found-action-accent: var(--brand-logo-blue);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: var(--spacing-12);
    padding: var(--space-md) var(--space-lg);
    overflow: hidden;
    color: var(--foreground);
    font-family: var(--font-cjk-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    transition:
      color 200ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .not-found__action::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--not-found-action-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .not-found__action--home {
    border-right: 1px solid var(--border);
  }

  .not-found__action--posts {
    --not-found-action-accent: var(--brand-logo-pink);
  }

  .not-found__action :global(svg) {
    flex: none;
    color: var(--muted-foreground);
    stroke-width: 1.5;
    transition:
      color 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .not-found__action:hover {
    color: var(--not-found-action-accent);
    background: color-mix(
      in srgb,
      var(--not-found-action-accent) 5%,
      transparent
    );
  }

  .not-found__action:hover::before,
  .not-found__action:focus-visible::before {
    transform: scaleX(1);
  }

  .not-found__action:hover :global(svg) {
    color: var(--not-found-action-accent);
  }

  .not-found__action--home:hover :global(svg) {
    transform: translateX(calc(var(--spacing-1) * -1));
  }

  .not-found__action--posts:hover :global(svg) {
    transform: translateX(var(--spacing-1));
  }

  .not-found__action:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .not-found__visual {
    position: relative;
    isolation: isolate;
    min-width: 0;
    min-height: 22rem;
  }

  .not-found__visual::before {
    content: "";
    position: absolute;
    inset: 16% 9%;
    z-index: -2;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--brand-logo-blue) 9%, transparent);
    filter: blur(var(--spacing-10));
    animation: not-found-breathe 4.8s ease-in-out infinite alternate;
  }

  .not-found__orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    display: block;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
    border-radius: var(--radius-full);
    pointer-events: none;
  }

  .not-found__orbit::after {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(var(--spacing-1) * -1);
    width: var(--spacing-2);
    height: var(--spacing-2);
    border-radius: var(--radius-full);
    background: var(--brand-logo-pink);
    box-shadow: 0 0 var(--space-md)
      color-mix(in srgb, var(--brand-logo-pink) 65%, transparent);
  }

  .not-found__orbit--outer {
    width: min(82%, 34rem);
    animation: not-found-orbit-outer 22s linear infinite;
  }

  .not-found__orbit--inner {
    width: min(58%, 24rem);
    border-color: color-mix(in srgb, var(--brand-logo-blue) 22%, transparent);
    animation: not-found-orbit-inner 15s linear infinite;
  }

  .not-found__orbit--inner::after {
    top: auto;
    right: auto;
    bottom: calc(var(--spacing-1) * -1);
    left: 50%;
    background: var(--brand-logo-blue);
    box-shadow: 0 0 var(--space-md)
      color-mix(in srgb, var(--brand-logo-blue) 65%, transparent);
  }

  .not-found__corner {
    position: absolute;
    z-index: 2;
    width: var(--space-lg);
    height: var(--space-lg);
    border-color: color-mix(in srgb, var(--foreground) 28%, transparent);
    pointer-events: none;
  }

  .not-found__corner--top-left {
    top: 11%;
    left: 5%;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .not-found__corner--top-right {
    top: 11%;
    right: 5%;
    border-top: 1px solid;
    border-right: 1px solid;
  }

  .not-found__corner--bottom-left {
    bottom: 11%;
    left: 5%;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }

  .not-found__corner--bottom-right {
    right: 5%;
    bottom: 11%;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  @keyframes not-found-reveal {
    from {
      opacity: 0;
      transform: translateY(var(--space-md));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes not-found-title-reveal {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
      transform: translateX(calc(var(--space-md) * -1));
    }

    to {
      opacity: 1;
      clip-path: inset(0);
      transform: translateX(0);
    }
  }

  @keyframes not-found-rule-in {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes not-found-pulse {
    50% {
      opacity: 0.45;
      transform: scale(0.72);
    }
  }

  @keyframes not-found-scan {
    0%,
    35% {
      transform: translateX(-100%);
    }

    72%,
    100% {
      transform: translateX(100%);
    }
  }

  @keyframes not-found-breathe {
    from {
      opacity: 0.48;
      transform: scale(0.92);
    }

    to {
      opacity: 0.86;
      transform: scale(1.06);
    }
  }

  @keyframes not-found-orbit-outer {
    from {
      transform: translate(-50%, -50%) rotate(12deg) scaleY(0.54);
    }

    to {
      transform: translate(-50%, -50%) rotate(372deg) scaleY(0.54);
    }
  }

  @keyframes not-found-orbit-inner {
    from {
      transform: translate(-50%, -50%) rotate(210deg) scaleY(0.68);
    }

    to {
      transform: translate(-50%, -50%) rotate(-150deg) scaleY(0.68);
    }
  }

  @media (min-width: 64rem) {
    .not-found__frame {
      grid-template-columns: minmax(22rem, 5fr) minmax(0, 7fr);
      grid-template-rows: minmax(0, 1fr);
      align-items: stretch;
      gap: clamp(var(--space-xl), 4vw, var(--space-3xl));
      padding-block: var(--space-xl);
    }

    .not-found__visual {
      display: flex;
      align-items: center;
      min-height: 32rem;
    }
  }

  @media (max-width: 30rem) {
    .not-found__frame {
      padding-top: var(--space-xl);
    }

    .not-found__eyebrow {
      margin-bottom: var(--space-lg);
    }

    .not-found__actions {
      margin-top: var(--space-xl);
    }

    .not-found__orbit--outer {
      width: 88%;
    }

    .not-found__corner {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__status,
    .not-found__status-light,
    .not-found__status-line::after,
    .not-found__title,
    .not-found__rule,
    .not-found__description,
    .not-found__actions,
    .not-found__visual::before,
    .not-found__orbit,
    .not-found__action,
    .not-found__action::before,
    .not-found__action :global(svg) {
      animation: none;
      transition: none;
    }

    .not-found__orbit--outer {
      transform: translate(-50%, -50%) rotate(12deg) scaleY(0.54);
    }

    .not-found__orbit--inner {
      transform: translate(-50%, -50%) rotate(210deg) scaleY(0.68);
    }
  }
</style>
