---
import type { PersonalPageData } from "../../data/personal-pages";
import { AbstractSpecimen, Container } from "../ui";

export interface Props {
  data: PersonalPageData;
}

const { data } = Astro.props as Props;
---

<article class:list={["personal-page", `personal-page--${data.variant}`]}>
  <Container size="xl" class="personal-page__container">
    <header class="personal-page__hero">
      <div class="personal-page__intro">
        <p class="personal-page__eyebrow">{data.eyebrow}</p>
        <h1>{data.title}</h1>
        <p class="personal-page__lead">{data.lead}</p>
        <p class="personal-page__note">{data.note}</p>
      </div>
      <AbstractSpecimen variant={data.variant} />
    </header>

    <div class="personal-page__body">
      <aside class="personal-page__index" aria-label="页面目录">
        <span>INDEX</span>
        <ol>
          {
            data.groups.map((group, index) => (
              <li>
                <a href={`#group-${index + 1}`}>
                  {String(index + 1).padStart(2, "0")} {group.title}
                </a>
              </li>
            ))
          }
        </ol>
      </aside>

      <div class="personal-page__groups">
        {
          data.groups.map((group, groupIndex) => (
            <section
              id={`group-${groupIndex + 1}`}
              class="personal-page__group"
            >
              <header class="personal-page__group-head">
                <span>{String(groupIndex + 1).padStart(2, "0")}</span>
                <div>
                  <h2>{group.title}</h2>
                  {group.description && <p>{group.description}</p>}
                </div>
              </header>
              <div class="personal-page__entries">
                {group.entries.map((entry) => {
                  const Tag = entry.href ? "a" : "div";
                  return (
                    <Tag
                      class:list={[
                        "personal-page__entry",
                        entry.href && "personal-page__entry--link",
                      ]}
                      href={entry.href}
                      target={entry.external ? "_blank" : undefined}
                      rel={entry.external ? "noreferrer" : undefined}
                    >
                      <div class="personal-page__entry-copy">
                        <h3>{entry.title}</h3>
                        <p>{entry.description}</p>
                        {entry.tags && (
                          <ul
                            class="personal-page__tags"
                            aria-label={`${entry.title} 技术标签`}
                          >
                            {entry.tags.map((tag) => (
                              <li>{tag}</li>
                            ))}
                          </ul>
                        )}
                      </div>
                      <div class="personal-page__entry-meta">
                        {entry.meta && <span>{entry.meta}</span>}
                        {entry.href && (
                          <span class="personal-page__arrow" aria-hidden="true">
                            ↗
                          </span>
                        )}
                      </div>
                    </Tag>
                  );
                })}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</article>

<style>
  .personal-page {
    padding-block: calc(var(--header-height) + var(--space-3xl))
      var(--space-3xl);
  }

  .personal-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    gap: clamp(var(--space-xl), 6vw, var(--space-3xl));
    align-items: end;
    min-height: min(48rem, calc(100dvh - var(--header-height)));
    padding-bottom: var(--space-3xl);
  }

  .personal-page__intro {
    padding-block: var(--space-2xl);
  }
  .personal-page__eyebrow,
  .personal-page__note,
  .personal-page__index,
  .personal-page__group-head > span,
  .personal-page__entry-meta,
  .personal-page__tags {
    font-family: var(--font-mono);
  }

  .personal-page__eyebrow {
    margin: 0 0 var(--space-lg);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--brand-logo-blue);
  }

  .personal-page h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.9rem, 6.6vw, 6.8rem);
    font-weight: var(--font-weight-medium);
    line-height: 0.98;
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .personal-page__lead {
    max-width: 37rem;
    margin: var(--space-xl) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .personal-page__note {
    margin: var(--space-xl) 0 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .personal-page__body {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: clamp(var(--space-xl), 8vw, var(--space-3xl));
    border-top: 1px solid var(--foreground);
  }

  .personal-page__index {
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
    align-self: start;
    padding-top: var(--space-xl);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .personal-page__index > span {
    color: var(--muted-foreground);
  }
  .personal-page__index ol {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }
  .personal-page__index a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .personal-page__index a:hover {
    color: var(--brand-logo-blue);
  }
  .personal-page__index a:focus-visible,
  .personal-page__entry--link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  .personal-page__group {
    padding-block: var(--space-3xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }
  .personal-page__group + .personal-page__group {
    border-top: 1px solid var(--border);
  }
  .personal-page__group-head {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }
  .personal-page__group-head > span {
    padding-top: 0.45rem;
    font-size: var(--text-xs);
    color: var(--brand-logo-blue);
  }
  .personal-page__group-head h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
  }
  .personal-page__group-head p {
    max-width: 42rem;
    margin: var(--space-md) 0 0;
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
  }

  .personal-page__entries {
    display: grid;
  }
  .personal-page__entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, auto);
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-sm);
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }
  .personal-page__entry:last-child {
    border-bottom: 1px solid var(--border);
  }
  .personal-page__entry--link:hover {
    background: var(--interactive-hover-surface);
    transform: translateX(0.25rem);
  }
  .personal-page__entry h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
  }
  .personal-page__entry p {
    max-width: 44rem;
    margin: var(--space-sm) 0 0;
    color: var(--muted-foreground);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }
  .personal-page__entry-meta {
    display: flex;
    gap: var(--space-md);
    justify-content: flex-end;
    align-items: flex-start;
    font-size: var(--text-xs);
    text-align: right;
    color: var(--muted-foreground);
  }
  .personal-page__arrow {
    font-size: var(--text-lg);
    color: var(--foreground);
    transition: transform 180ms ease;
  }
  .personal-page__entry--link:hover .personal-page__arrow {
    transform: translate(0.2rem, -0.2rem);
  }
  .personal-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .personal-page__tags li::before {
    content: "#";
    color: var(--brand-logo-pink);
  }

  @media (width < 900px) {
    .personal-page__hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .personal-page__body {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .personal-page__index {
      position: static;
      border-bottom: 1px solid var(--border);
      padding-bottom: var(--space-xl);
    }
    .personal-page__index ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 600px) {
    .personal-page {
      padding-top: calc(var(--header-height-mobile) + var(--space-2xl));
    }
    .personal-page__hero {
      gap: var(--space-xl);
      padding-bottom: var(--space-2xl);
    }
    .personal-page h1 {
      font-size: clamp(2.65rem, 14vw, 4.3rem);
    }
    .personal-page__entry {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding-inline: 0;
    }
    .personal-page__entry-meta {
      justify-content: space-between;
      text-align: left;
    }
    .personal-page__group {
      padding-block: var(--space-2xl);
    }
    .personal-page__group-head {
      grid-template-columns: 2rem 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .personal-page__index a,
    .personal-page__entry,
    .personal-page__arrow {
      transition: none;
    }
    .personal-page__entry--link:hover {
      transform: none;
    }
  }
</style>
