        pointerStartX = pointerLastX = event.clientX;
        pointerStartY = event.clientY;
        pointerAxis = null;
        pointerTravel = 0;
        canvas.setPointerCapture(event.pointerId);
      });

      canvas.addEventListener(
        "pointermove",
        (event) => {
          if (pointerId !== event.pointerId || !isActive()) return;
          const totalX = event.clientX - pointerStartX;
          const totalY = event.clientY - pointerStartY;
          if (!pointerAxis) {
            if (Math.abs(totalX) < 8 && Math.abs(totalY) < 8) return;
            pointerAxis = Math.abs(totalX) > Math.abs(totalY) ? "x" : "y";
          }
          if (pointerAxis !== "x") return;
          const delta = pointerLastX - event.clientX;
          pointerLastX = event.clientX;
          pointerTravel += Math.abs(delta);
          if (delta !== 0 && canConsume(delta)) {
            event.preventDefault();
            consumeHorizontalDelta(delta);
          }
        },
        { passive: false },
      );

      const finishPointer = (event: PointerEvent) => {
        if (pointerId !== event.pointerId) return;
