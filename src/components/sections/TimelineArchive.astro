---
import type { Locale } from "../../lib/site-config";
import { groupTimelineItems, type TimelineItem } from "../../lib/timeline";
import { t } from "../../i18n/ui";
import { resolveRoute } from "../../i18n/routes";
import ThemeToggle from "../layout/ThemeToggle.astro";
import { Icon } from "../ui/index";

export interface Props {
  items: TimelineItem[];
  locale?: Locale;
}

type TimelineSide = "above" | "below";

interface TrackEvent {
  item: TimelineItem;
  x: number;
  side: TimelineSide;
  y: number;
}

interface TrackMonth {
  year: number;
  month: number;
  start: number;
  width: number;
  x: number;
  populated: boolean;
  posts: number;
  daily: number;
  total: number;
}

const { items, locale = "zh-CN" } = Astro.props as Props;
const years = groupTimelineItems(items);
const monthLabels = [
  "JAN",
  "FEB",
  "MAR",
  "APR",
  "MAY",
  "JUN",
  "JUL",
  "AUG",
  "SEP",
  "OCT",
  "NOV",
  "DEC",
];
const monthFullLabels = [
  "JANUARY",
  "FEBRUARY",
  "MARCH",
  "APRIL",
  "MAY",
  "JUNE",
  "JULY",
  "AUGUST",
  "SEPTEMBER",
  "OCTOBER",
  "NOVEMBER",
  "DECEMBER",
];
const monthNames = [
  "一月",
  "二月",
  "三月",
  "四月",
  "五月",
  "六月",
  "七月",
  "八月",
  "九月",
  "十月",
  "十一月",
  "十二月",
];
const homeHref = resolveRoute(locale, "/");

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    timeZone: "UTC",
  }).format(date);
}

const sortedItems = items.toSorted(
  (left, right) => left.date.getTime() - right.date.getTime(),
);
const emptyMonthWidth = 80;
const pixelsPerItem = 280;
const minimumActiveMonthWidth = 350;
const cardWidth = 250;
const cardHeight = 150;
const lanes = [-75, 75, -220, 220];

const firstDate = sortedItems[0]?.date;
const lastDate = sortedItems.at(-1)?.date;
const startYear = firstDate?.getUTCFullYear() ?? 0;
const startMonth = firstDate?.getUTCMonth() ?? 0;
const endYear = lastDate?.getUTCFullYear() ?? startYear;
const endMonth = lastDate?.getUTCMonth() ?? startMonth;
const totalMonths = firstDate
  ? (endYear - startYear) * 12 + (endMonth - startMonth) + 1
  : 0;
const monthItems = Array.from(
  { length: totalMonths },
  () => [] as TimelineItem[],
);

for (const item of sortedItems) {
  const monthIndex =
    (item.date.getUTCFullYear() - startYear) * 12 +
    (item.date.getUTCMonth() - startMonth);
  monthItems[monthIndex]?.push(item);
}

const monthWidths = monthItems.map((month) =>
  month.length === 0
    ? emptyMonthWidth
    : Math.max(minimumActiveMonthWidth, month.length * pixelsPerItem),
);
const monthStarts: number[] = [];
let trackWidth = 0;
for (const width of monthWidths) {
  monthStarts.push(trackWidth);
  trackWidth += width;
}

const trackMonths: TrackMonth[] = monthItems.map((month, index) => {
  const absoluteMonth = startMonth + index;
  const year = startYear + Math.floor(absoluteMonth / 12);
  const monthNumber = (absoluteMonth % 12) + 1;
  const width = monthWidths[index];
  const start = monthStarts[index];
  return {
    year,
    month: monthNumber,
    start,
    width,
    x: start + width / 2,
    populated: month.length > 0,
    posts: month.filter((item) => item.kind === "post").length,
    daily: month.filter((item) => item.kind === "daily").length,
    total: month.length,
  };
});

const trackEvents: TrackEvent[] = [];
const placed: Array<{ x: number; y: number }> = [];

monthItems.forEach((month, monthIndex) => {
  const monthStart = monthStarts[monthIndex];
  const monthWidth = monthWidths[monthIndex];
  const padding = cardWidth * 0.55;
  const usableWidth = monthWidth - padding * 2;

  month.forEach((item, localIndex) => {
    const x =
      month.length === 1
        ? monthStart + monthWidth / 2
        : monthStart +
          padding +
          (usableWidth / (month.length - 1)) * localIndex;
    let y = lanes[0];
    let minimumOverlap = Number.POSITIVE_INFINITY;
    const startLane = localIndex % lanes.length;

    for (let laneIndex = 0; laneIndex < lanes.length; laneIndex += 1) {
      const lane = lanes[(startLane + laneIndex) % lanes.length];
      let worstOverlap = 0;
      for (const previous of placed) {
        const overlapX = Math.max(0, cardWidth - Math.abs(x - previous.x));
        const overlapY = Math.max(0, cardHeight - Math.abs(lane - previous.y));
        worstOverlap = Math.max(worstOverlap, overlapX * overlapY);
      }
      if (worstOverlap < minimumOverlap) {
        minimumOverlap = worstOverlap;
        y = lane;
        if (worstOverlap === 0) break;
      }
    }

    placed.push({ x, y });
    trackEvents.push({
      item,
      x,
      y,
      side: y < 0 ? "above" : "below",
    });
  });
});

const trackYears = years
  .map((year) => {
    const months = trackMonths.filter((month) => month.year === year.year);
    const events = trackEvents.filter(
      (event) => event.item.date.getUTCFullYear() === year.year,
    );
    return {
      ...year,
      months,
      events,
      start: months[0]?.start ?? 0,
      end: months.length ? months.at(-1)!.start + months.at(-1)!.width : 0,
    };
  })
  .filter((year) => year.months.length > 0);

const firstTrackYear = trackYears[0];
const firstTrackMonth =
  firstTrackYear?.months.find((month) => month.populated) ??
  firstTrackYear?.months[0];
const fallbackTravel = Math.round(trackWidth * 1.5);
---

<section
  class="timeline"
  data-timeline-root
  data-quality="standard"
  aria-labelledby="timeline-title"
>
  <div class="timeline__texture" aria-hidden="true"></div>

  <nav class="timeline-tools" aria-label={t(locale, "timeline.tools")}>
    <a class="timeline-tools__control" href={homeHref}>
      <Icon name="lucide:house" size="1.125rem" decorative />
      <span>{t(locale, "timeline.home")}</span>
    </a>
    <button
      class="timeline-tools__control"
      type="button"
      data-search-trigger
      aria-label={t(locale, "aria.searchButton")}
    >
      <Icon name="lucide:search" size="1.125rem" decorative />
      <span>{t(locale, "nav.search")}</span>
    </button>
    <div class="timeline-tools__theme">
      <ThemeToggle locale={locale} />
    </div>
  </nav>

  <button
    class="timeline-quality"
    type="button"
    aria-pressed="false"
    aria-label={t(locale, "timeline.qualityEnable")}
    data-quality-toggle
    data-quality-enable={t(locale, "timeline.qualityEnable")}
    data-quality-disable={t(locale, "timeline.qualityDisable")}
  >
    <Icon name="lucide:sparkles" size="0.95rem" decorative />
    <span class="timeline-quality__name">HQ</span>
    <span class="timeline-quality__state" data-quality-state>OFF</span>
  </button>

  <h1 id="timeline-title" class="timeline__title">
    {t(locale, "timeline.title")}
  </h1>

  {
    years.length > 0 ? (
      <>
        <div
          class="timeline-scroll"
          data-timeline-scroll
          style={`--timeline-fallback-travel: ${fallbackTravel}px;`}
          aria-label={t(locale, "timeline.archive")}
        >
          <div class="timeline-canvas">
            {firstTrackYear && firstTrackMonth && (
              <header class="timeline-year-summary" data-year-summary>
                <div
                  class="timeline-year-summary__year-viewport"
                  data-year-viewport
                  aria-live="polite"
                  aria-atomic="true"
                >
                  <span class="timeline-year-summary__year" data-year-value>
                    {firstTrackYear.year}
                  </span>
                </div>
                <div class="timeline-year-summary__rule" aria-hidden="true" />
                <section class="timeline-year-summary__month">
                  <p data-summary-month>
                    {monthFullLabels[firstTrackMonth.month - 1]}
                  </p>
                  <dl>
                    <div>
                      <dt>{t(locale, "timeline.statsPosts")}</dt>
                      <dd data-summary-month-posts>{firstTrackMonth.posts}</dd>
                    </div>
                    <div>
                      <dt>{t(locale, "timeline.statsDaily")}</dt>
                      <dd data-summary-month-daily>{firstTrackMonth.daily}</dd>
                    </div>
                    <div>
                      <dt>{t(locale, "timeline.statsTotal")}</dt>
                      <dd data-summary-month-total>{firstTrackMonth.total}</dd>
                    </div>
                  </dl>
                </section>
                <section class="timeline-year-summary__yearly">
                  <p>{t(locale, "timeline.yearlyTotal")}</p>
                  <dl>
                    <div>
                      <dt>{t(locale, "timeline.statsPosts")}</dt>
                      <dd data-summary-year-posts>
                        {firstTrackYear.stats.posts}
                      </dd>
                    </div>
                    <div>
                      <dt>{t(locale, "timeline.statsDaily")}</dt>
                      <dd data-summary-year-daily>
                        {firstTrackYear.stats.daily}
                      </dd>
                    </div>
                    <div>
                      <dt>{t(locale, "timeline.statsTotal")}</dt>
                      <dd data-summary-year-total>
                        {firstTrackYear.stats.total}
                      </dd>
                    </div>
                  </dl>
                </section>
              </header>
            )}

            <div
              class="timeline-track"
              data-timeline-track
              data-track-width={trackWidth}
              style={`--timeline-track-width: ${trackWidth}px;`}
            >
              <div class="timeline-track__line" aria-hidden="true" />

              {trackYears.map((year) => (
                <div
                  class="timeline-year-range"
                  data-track-year={year.year}
                  data-year-start={year.start}
                  data-year-end={year.end}
                  style={`--year-start: ${year.start}px; --year-width: ${year.end - year.start}px;`}
                  aria-hidden="true"
                />
              ))}

              <ol class="timeline-months" aria-hidden="true">
                {trackYears.flatMap((year) =>
                  year.months.map((month) => (
                    <li
                      style={`--month-x: ${month.x}px;`}
                      data-populated={month.populated ? "" : undefined}
                      data-track-month={month.month}
                      data-month-label={monthFullLabels[month.month - 1]}
                      data-month-year={year.year}
                      data-month-x={month.x}
                      data-month-posts={month.posts}
                      data-month-daily={month.daily}
                      data-month-total={month.total}
                      data-year-posts={year.stats.posts}
                      data-year-daily={year.stats.daily}
                      data-year-total={year.stats.total}
                    >
                      <i />
                      <span>
                        {monthLabels[month.month - 1]}
                        {month.month === 1 && <em>{year.year}</em>}
                      </span>
                    </li>
                  )),
                )}
              </ol>

              <ol class="timeline-events">
                {trackYears.flatMap((year) =>
                  year.events.map(({ item, x, side, y }) => (
                    <li
                      class={`timeline-event timeline-event--${side}`}
                      data-event-x={x}
                      data-event-y={y}
                      data-event-side={side}
                      style={`--event-x: ${x}px; --event-target-y: ${y}px;`}
                    >
                      <span class="timeline-event__anchor" aria-hidden="true">
                        <span class="timeline-event__node" />
                        <span class="timeline-event__connector" />
                      </span>
                      <div class="timeline-event__motion">
                        <a class="timeline-event__card" href={item.href}>
                          <span class="timeline-event__meta">
                            <span>
                              {item.kind === "post"
                                ? t(locale, "timeline.post")
                                : t(locale, "timeline.dailyOne")}
                            </span>
                            <time datetime={item.date.toISOString()}>
                              {formatDate(item.date)}
                            </time>
                          </span>
                          <strong>{item.title}</strong>
                          <span class="timeline-event__read">
                            {t(locale, "timeline.open")}
                            <Icon
                              name="lucide:arrow-up-right"
                              size="0.85rem"
                              decorative
                            />
                          </span>
                        </a>
                      </div>
                    </li>
                  )),
                )}
              </ol>
            </div>
          </div>
        </div>

        <div class="timeline-static" aria-label={t(locale, "timeline.archive")}>
          {years.map((year) => (
            <section class="timeline-static-year">
              <header>
                <h2>{year.year}</h2>
                <p>
                  {year.stats.posts} {t(locale, "timeline.posts")} ·{" "}
                  {year.stats.daily} {t(locale, "timeline.daily")}
                </p>
              </header>
              {year.months
                .filter((month) => month.items.length > 0)
                .map((month) => (
                  <section class="timeline-static-month">
                    <h3>
                      <span>{String(month.month).padStart(2, "0")}</span>
                      {monthNames[month.month - 1]}
                    </h3>
                    <ol>
                      {month.items.map((item) => (
                        <li>
                          <a href={item.href}>
                            <span>
                              {item.kind === "post"
                                ? t(locale, "timeline.post")
                                : t(locale, "timeline.dailyOne")}
                              <time datetime={item.date.toISOString()}>
                                {formatDate(item.date)}
                              </time>
                            </span>
                            <strong>{item.title}</strong>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </section>
                ))}
            </section>
          ))}
        </div>
        <noscript>
          <style
            is:global
            set:html={
              ".timeline-scroll{display:none!important}.timeline-static{display:grid!important}"
            }
          />
        </noscript>
      </>
    ) : (
      <p class="timeline-empty">{t(locale, "timeline.empty")}</p>
    )
  }
</section>

<script>
  const timelineRoot = document.querySelector<HTMLElement>(
    "[data-timeline-root]",
  );

  if (timelineRoot) {
    const scrollArea = timelineRoot.querySelector<HTMLElement>(
      "[data-timeline-scroll]",
    );
    const track = timelineRoot.querySelector<HTMLElement>(
      "[data-timeline-track]",
    );
    const canvas = timelineRoot.querySelector<HTMLElement>(".timeline-canvas");
    const yearSummary = timelineRoot.querySelector<HTMLElement>(
      "[data-year-summary]",
    );
    const yearViewport = timelineRoot.querySelector<HTMLElement>(
      "[data-year-viewport]",
    );
    const monthMarkers = [
      ...timelineRoot.querySelectorAll<HTMLElement>("[data-track-month]"),
    ];
    const eventNodes = [
      ...timelineRoot.querySelectorAll<HTMLElement>(".timeline-event"),
    ];
    const qualityButton = timelineRoot.querySelector<HTMLButtonElement>(
      "[data-quality-toggle]",
    );
    const qualityState = qualityButton?.querySelector<HTMLElement>(
      "[data-quality-state]",
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const qualityStorageKey = "timeline-quality";
    let quality: "standard" | "hq" = "standard";
    let frame = 0;
    let yearFrame = 0;
    let yearTransitionToken = 0;
    let visibleYear = yearViewport
      ?.querySelector<HTMLElement>("[data-year-value]")
      ?.textContent?.trim();

    const createYearNode = (year: string) => {
      const template =
        yearViewport?.querySelector<HTMLElement>("[data-year-value]");
      const node = template
        ? (template.cloneNode(false) as HTMLElement)
        : document.createElement("span");
      node.classList.add("timeline-year-summary__year");
      node.dataset.yearValue = "";
      node.textContent = year;
      return node;
    };

    const transitionYear = (nextYear: string) => {
      if (!yearViewport || !nextYear || nextYear === visibleYear) return;

      yearTransitionToken += 1;
      const transitionToken = yearTransitionToken;
      if (yearFrame) cancelAnimationFrame(yearFrame);

      const outgoing = createYearNode(visibleYear ?? nextYear);
      const incoming = createYearNode(nextYear);
      yearViewport.replaceChildren(outgoing, incoming);
      visibleYear = nextYear;

      if (reducedMotion.matches) {
        yearViewport.replaceChildren(incoming);
        return;
      }

      outgoing.style.transform = "translate3d(0, 0, 0)";
      outgoing.style.opacity = "1";
      incoming.style.transform = "translate3d(0, 50px, 0)";
      incoming.style.opacity = "0";

      const duration = 600;
      let startedAt = 0;
      const animate = (now: number) => {
        if (transitionToken !== yearTransitionToken) return;
        if (!startedAt) startedAt = now;
        const elapsed = Math.min(1, (now - startedAt) / duration);
        const eased = 1 - (1 - elapsed) ** 3;

        outgoing.style.transform = `translate3d(0, ${-50 * eased}px, 0)`;
        outgoing.style.opacity = String(1 - eased);
        incoming.style.transform = `translate3d(0, ${50 * (1 - eased)}px, 0)`;
        incoming.style.opacity = String(eased);

        if (elapsed < 1) {
          yearFrame = requestAnimationFrame(animate);
          return;
        }

        yearFrame = 0;
        incoming.style.removeProperty("transform");
        incoming.style.removeProperty("opacity");
        yearViewport.replaceChildren(incoming);
      };

      yearFrame = requestAnimationFrame(animate);
    };

    const syncQuality = (nextQuality: "standard" | "hq") => {
      quality = nextQuality;
      const isHighQuality = quality === "hq";
      timelineRoot.dataset.quality = quality;
      qualityButton?.setAttribute("aria-pressed", String(isHighQuality));
      qualityButton?.setAttribute(
        "aria-label",
        isHighQuality
          ? (qualityButton.dataset.qualityDisable ?? "")
          : (qualityButton.dataset.qualityEnable ?? ""),
      );
      if (qualityState) qualityState.textContent = isHighQuality ? "ON" : "OFF";
    };

    try {
      syncQuality(
        localStorage.getItem(qualityStorageKey) === "hq" ? "hq" : "standard",
      );
    } catch {
      syncQuality("standard");
    }

    qualityButton?.addEventListener("click", () => {
      const nextQuality = quality === "hq" ? "standard" : "hq";
      syncQuality(nextQuality);
      updateTimeline();
      try {
        localStorage.setItem(qualityStorageKey, nextQuality);
      } catch {
        // The visual mode still works when storage is unavailable.
      }
    });

    const updateTimeline = () => {
      frame = 0;
      if (!scrollArea || !track || reducedMotion.matches) return;

      const viewportWidth = canvas?.clientWidth ?? window.innerWidth;
      const viewportHeight = window.innerHeight;
      const totalWidth = Number(track.dataset.trackWidth ?? 0);
      const rect = scrollArea.getBoundingClientRect();
      const travel = Math.max(1, scrollArea.offsetHeight - viewportHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / travel));
      const timelineX = progress * totalWidth;
      const trackX = viewportWidth / 2 - timelineX;

      track.style.transform = `translate3d(${trackX}px, 0, 0)`;
      timelineRoot.style.setProperty("--timeline-progress", String(progress));

      const activeMonth =
        monthMarkers.find(
          (month) => Number(month.dataset.monthX ?? 0) >= timelineX,
        ) ?? monthMarkers.at(-1);
      const activeYear = activeMonth?.dataset.monthYear;

      if (yearSummary && activeMonth && activeYear) {
        transitionYear(activeYear);
        const monthNumber = Number(activeMonth.dataset.trackMonth ?? 1);
        const monthName = yearSummary.querySelector<HTMLElement>(
          "[data-summary-month]",
        );
        const monthPosts = yearSummary.querySelector<HTMLElement>(
          "[data-summary-month-posts]",
        );
        const monthDaily = yearSummary.querySelector<HTMLElement>(
          "[data-summary-month-daily]",
        );
        const monthTotal = yearSummary.querySelector<HTMLElement>(
          "[data-summary-month-total]",
        );
        const yearPosts = yearSummary.querySelector<HTMLElement>(
          "[data-summary-year-posts]",
        );
        const yearDaily = yearSummary.querySelector<HTMLElement>(
          "[data-summary-year-daily]",
        );
        const yearTotal = yearSummary.querySelector<HTMLElement>(
          "[data-summary-year-total]",
        );
        if (monthName)
          monthName.textContent =
            activeMonth.dataset.monthLabel ?? String(monthNumber);
        if (monthPosts)
          monthPosts.textContent = activeMonth.dataset.monthPosts ?? "0";
        if (monthDaily)
          monthDaily.textContent = activeMonth.dataset.monthDaily ?? "0";
        if (monthTotal)
          monthTotal.textContent = activeMonth.dataset.monthTotal ?? "0";
        if (yearPosts)
          yearPosts.textContent = activeMonth.dataset.yearPosts ?? "0";
        if (yearDaily)
          yearDaily.textContent = activeMonth.dataset.yearDaily ?? "0";
        if (yearTotal)
          yearTotal.textContent = activeMonth.dataset.yearTotal ?? "0";
      }

      for (const eventNode of eventNodes) {
        const targetX = Number(eventNode.dataset.eventX ?? 0);
        const targetY = Number(eventNode.dataset.eventY ?? 0);
        const delta = targetX - timelineX;
        const distance = Math.abs(delta);
        const entry = Math.max(0, Math.min(1, 1 - delta / 1000));
        const passed = delta < 0;
        const opacity = passed
          ? Math.max(0, 1 - Math.max(0, distance - viewportWidth * 0.35) / 150)
          : Math.max(0.4, 1 - distance / 1500);
        const liveY = passed ? targetY : targetY * entry;
        const enterX = passed ? 0 : (1 - entry) * 400;
        const enterY = passed ? 0 : (1 - entry) * 300;
        const scale = 0.9 + opacity * 0.1;
        const rotate = passed ? 0 : (1 - entry) * 10;
        const rotateY =
          quality === "hq" ? Math.max(-5, Math.min(5, delta * 0.004)) : 0;

        eventNode.style.setProperty("--event-opacity", String(opacity));
        eventNode.style.setProperty(
          "--event-z",
          String(Math.round(100 - distance / 20)),
        );
        eventNode.style.setProperty("--event-entry", String(entry));
        eventNode.style.setProperty("--event-enter-x", `${enterX}px`);
        eventNode.style.setProperty("--event-enter-y", `${enterY}px`);
        eventNode.style.setProperty("--event-live-y", `${liveY}px`);
        eventNode.style.setProperty(
          "--event-line-y",
          `${Math.min(0, liveY)}px`,
        );
        eventNode.style.setProperty(
          "--event-line-height",
          `${Math.abs(liveY)}px`,
        );
        eventNode.style.setProperty("--event-scale", String(scale));
        eventNode.style.setProperty("--event-rotate", `${rotate}deg`);
        eventNode.style.setProperty("--event-rotate-y", `${rotateY}deg`);
        eventNode.style.setProperty(
          "--event-blur",
          quality === "hq" ? `${(1 - opacity) * 4}px` : "0px",
        );
        eventNode.style.setProperty(
          "--event-grayscale",
          quality === "hq" ? String((1 - opacity) * 0.5) : "0",
        );
      }
    };

    const syncTravel = () => {
      if (!scrollArea || !track || reducedMotion.matches) return;
      const totalWidth = Number(track.dataset.trackWidth ?? 0);
      scrollArea.style.height = `${window.innerHeight + totalWidth * 1.5}px`;
      updateTimeline();
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateTimeline);
    };

    timelineRoot.dataset.enhanced = "";
    syncTravel();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", syncTravel, { passive: true });

    if (canvas && scrollArea && !reducedMotion.matches) {
      const scrollFactor = 1.5;
      const clampScroll = (value: number) => {
        const start = scrollArea.offsetTop;
        const end = start + Math.max(0, scrollArea.offsetHeight - innerHeight);
        return Math.min(end, Math.max(start, value));
      };
      const isActive = () => {
        const start = scrollArea.offsetTop;
        const end = start + Math.max(0, scrollArea.offsetHeight - innerHeight);
        return scrollY >= start && scrollY <= end;
      };
      const canConsume = (delta: number) => {
        const start = scrollArea.offsetTop;
        const end = start + Math.max(0, scrollArea.offsetHeight - innerHeight);
        return delta > 0 ? scrollY < end - 0.5 : scrollY > start + 0.5;
      };
      const consumeHorizontalDelta = (delta: number) => {
        if (delta === 0) return;
        scrollTo({
          top: clampScroll(scrollY + delta * scrollFactor),
          behavior: "auto",
        });
      };

      let wheelAxis: "x" | "y" | null = null;
      let wheelX = 0;
      let wheelY = 0;
      let lastWheel = 0;
      let pendingWheel = 0;
      let wheelFrame = 0;

      canvas.addEventListener(
        "wheel",
        (event) => {
          if (!isActive()) return;
          const now = performance.now();
          if (now - lastWheel > 120) {
            wheelAxis = null;
            wheelX = 0;
            wheelY = 0;
          }
          lastWheel = now;

          const unit =
            event.deltaMode === WheelEvent.DOM_DELTA_LINE
              ? 16
              : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
                ? innerHeight
                : 1;
          const rawX = event.deltaX * unit;
          const deltaX =
            event.shiftKey && Math.abs(rawX) < 0.5 ? event.deltaY * unit : rawX;
          const deltaY = event.shiftKey ? 0 : event.deltaY * unit;
          wheelX += deltaX;
          wheelY += deltaY;

          if (!wheelAxis) {
            if (Math.max(Math.abs(wheelX), Math.abs(wheelY)) < 6) return;
            wheelAxis =
              event.shiftKey || Math.abs(wheelX) >= Math.abs(wheelY) * 0.8
                ? "x"
                : "y";
          }
          if (wheelAxis !== "x" || deltaX === 0 || !canConsume(deltaX)) {
            return;
          }

          event.preventDefault();
          pendingWheel += deltaX;
          if (!wheelFrame) {
            wheelFrame = requestAnimationFrame(() => {
              wheelFrame = 0;
              const delta = pendingWheel;
              pendingWheel = 0;
              consumeHorizontalDelta(delta);
            });
          }
        },
        { passive: false },
      );

      let pointerId: number | null = null;
      let pointerStartX = 0;
      let pointerStartY = 0;
      let pointerLastX = 0;
      let pointerAxis: "x" | "y" | null = null;
      let pointerTravel = 0;
      let suppressClickUntil = 0;

      canvas.addEventListener("pointerdown", (event) => {
        if (
          !isActive() ||
          !event.isPrimary ||
          (event.pointerType !== "touch" && event.pointerType !== "pen")
