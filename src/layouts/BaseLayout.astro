---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SearchModal from "../components/layout/SearchModal.astro";
import SEO from "../components/seo/SEO.astro";
import Analytics from "../components/layout/Analytics.astro";
import { SITE_CONFIG, type Locale } from "../lib/site-config";
import { t } from "../i18n/ui";
import "../styles/global.css";
// Preload the primary heading + body fonts so they are ready before first paint.
import anthropicSans from "../assets/fonts/anthropic/AnthropicSans-Text-Regular-Static.otf?url";
import anthropicSerif from "../assets/fonts/anthropic/AnthropicSerif-Text-Medium-Static.otf?url";
import notoSans400Common1 from "@fontsource/noto-sans-sc/files/noto-sans-sc-117-400-normal.woff2?url";
import notoSans400Common2 from "@fontsource/noto-sans-sc/files/noto-sans-sc-118-400-normal.woff2?url";
import notoSans400Common3 from "@fontsource/noto-sans-sc/files/noto-sans-sc-119-400-normal.woff2?url";
import notoSerif500Common1 from "@fontsource/noto-serif-sc/files/noto-serif-sc-117-500-normal.woff2?url";
import notoSerif500Common2 from "@fontsource/noto-serif-sc/files/noto-serif-sc-118-500-normal.woff2?url";
import notoSerif500Common3 from "@fontsource/noto-serif-sc/files/noto-serif-sc-119-500-normal.woff2?url";
import notoSerif700Archive1 from "@fontsource/noto-serif-sc/files/noto-serif-sc-113-700-normal.woff2?url";
import notoSerif700Archive2 from "@fontsource/noto-serif-sc/files/noto-serif-sc-114-700-normal.woff2?url";
import notoSerif700Common1 from "@fontsource/noto-serif-sc/files/noto-serif-sc-117-700-normal.woff2?url";
import notoSerif700Common2 from "@fontsource/noto-serif-sc/files/noto-serif-sc-118-700-normal.woff2?url";

const primaryChineseFonts = [
  notoSans400Common1,
  notoSans400Common2,
  notoSans400Common3,
  notoSerif500Common1,
  notoSerif500Common2,
  notoSerif500Common3,
];

export interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  path?: string;
  ogImage?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  showThemeToggle?: boolean;
  showHeaderBrand?: boolean;
  monochromeHeader?: boolean;
  preloadPrimaryFonts?: boolean;
  colorPreview?: boolean;
  deferPageResources?: boolean;
  pageId?: string;
}

// For i18n routing, prefer path from Astro.currentRoute
const { currentLocale, ...restProps } = Astro.props as Props & {
  currentLocale?: Locale;
};

const {
  title,
  description = SITE_CONFIG.description,
  locale = currentLocale || SITE_CONFIG.defaultLocale,
  path = "/",
  ogImage,
  showHeader = true,
  showFooter = true,
  showThemeToggle = true,
  showHeaderBrand = true,
  monochromeHeader = false,
  preloadPrimaryFonts = true,
  colorPreview = false,
  deferPageResources = false,
  pageId,
} = restProps;
const homeEntranceSessionKey = "hero-ascii-ripple:v3";

function defaultOgImage(routePath: string) {
  if (routePath === "/") return `/og/home/${locale}`;
  if (routePath === "/posts") return `/og/blog-list/${locale}`;
  if (routePath.startsWith("/posts/"))
    return `/og/blog/${locale}/${routePath.replace(/^\/posts\//, "")}`;
  return `/og/page/${locale}${routePath}`;
}
---

<!doctype html>
<html
  lang={locale}
  data-color-preview={colorPreview ? "true" : undefined}
  data-page={pageId}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:inline>
      html[data-font-gate] body {
        transition: opacity 150ms ease-out;
      }

      html[data-font-gate="pending"] body {
        opacity: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        html[data-font-gate] body {
          transition: none;
        }
      }
    </style>
    <script
      is:inline
      define:vars={{
        gatePrimaryFonts: preloadPrimaryFonts && !deferPageResources,
      }}
    >
      if (gatePrimaryFonts) {
        document.documentElement.dataset.fontGate = "pending";
        // Never leave the page hidden if a font request or script fails.
        window.setTimeout(() => {
          document.documentElement.dataset.fontGate = "ready";
        }, 4000);
      }
    </script>

    {
      preloadPrimaryFonts && !deferPageResources && (
        <>
          <link
            rel="preload"
            href={anthropicSerif}
            as="font"
            type="font/otf"
            crossorigin="anonymous"
          />
          <link
            rel="preload"
            href={anthropicSans}
            as="font"
            type="font/otf"
            crossorigin="anonymous"
          />
          {[
            ...primaryChineseFonts,
            ...(path === "/posts"
              ? [
                  notoSerif700Archive1,
                  notoSerif700Archive2,
                  notoSerif700Common1,
                  notoSerif700Common2,
                ]
              : []),
          ].map((href) => (
            <link
              rel="preload"
              href={href}
              as="font"
              type="font/woff2"
              crossorigin="anonymous"
            />
          ))}
        </>
      )
    }

    <script
      is:inline
      define:vars={{ deferPageResources, homeEntranceSessionKey }}
    >
      if (deferPageResources) {
        const root = document.documentElement;
        const shouldWait = (() => {
          try {
            return (
              !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
              !window.sessionStorage.getItem(homeEntranceSessionKey)
            );
          } catch {
            return false;
          }
        })();

        root.dataset.homeResourceState = shouldWait ? "waiting" : "ready";

        const release = () => {
          if (
            root.dataset.homeResourceState === "loading" ||
            root.dataset.homeResourceState === "revealing" ||
            root.dataset.homeResourceState === "released"
          ) {
            return;
          }
          const hero = document.querySelector('[data-ascii-entrance="ripple"]');
          const shouldReveal =
            shouldWait &&
            hero instanceof HTMLElement &&
            hero.dataset.asciiEntranceState === "complete" &&
            hero.dataset.asciiEntranceReason === "played";
          const images = Array.from(
            document.querySelectorAll("img[data-home-src]"),
          );
          const pending = images.map(
            (image) =>
              new Promise((resolve) => {
                const source = image.dataset.homeSrc;
                if (!source) {
                  resolve(undefined);
                  return;
                }
                image.addEventListener("load", resolve, { once: true });
                image.addEventListener("error", resolve, { once: true });
                image.src = source;
                delete image.dataset.homeSrc;
                if (image.complete) resolve(undefined);
              }),
          );

          if (shouldWait) root.dataset.homeResourceState = "loading";
          Promise.race([
            Promise.all(pending),
            new Promise((resolve) => window.setTimeout(resolve, 700)),
          ]).finally(() => {
            if (!shouldReveal) {
              root.dataset.homeResourceState = "released";
              window.dispatchEvent(new CustomEvent("home-resources-ready"));
              return;
            }

            const revealTail = document.querySelector(".hero__footer");
            let revealFallback = 0;
            const finishReveal = () => {
              if (root.dataset.homeResourceState !== "revealing") return;
              window.clearTimeout(revealFallback);
              revealTail?.removeEventListener("animationend", onRevealEnd);
              root.dataset.homeResourceState = "released";
              window.dispatchEvent(new CustomEvent("home-reveal-complete"));
            };
            const onRevealEnd = (event) => {
              if (event.target === revealTail) finishReveal();
            };

            revealTail?.addEventListener("animationend", onRevealEnd);
            root.dataset.homeResourceState = "revealing";
            window.dispatchEvent(new CustomEvent("home-resources-ready"));
            revealFallback = window.setTimeout(finishReveal, 900);
          });
        };

        window.addEventListener("home-resources-release", release);
        if (!shouldWait) {
          window.addEventListener("DOMContentLoaded", release, { once: true });
        } else {
          window.setTimeout(release, 7000);
        }
      }
    </script>

    <!-- Dark mode bootstrap (prevents FOUC) -->
    <script is:inline>
      function applyTheme() {
        try {
          // Honor the main-site key first, then Starlight's key (so a choice made
          // in the /docs section carries over), then the OS preference.
          const stored =
            localStorage.getItem("theme") ||
            localStorage.getItem("starlight-theme");
          if (stored === "dark") {
            document.documentElement.classList.add("dark");
            return;
          }
          if (
            (!stored || stored === "auto") &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {
          console.warn("dark mode:", e);
        }
      }
      applyTheme();
    </script>

    {
      Astro.slots.has("seo") ? (
        <slot name="seo" />
      ) : (
        <SEO
          title={title}
          description={description}
          locale={locale}
          path={path}
          ogImage={ogImage ?? defaultOgImage(path)}
        />
      )
    }

    <!-- Security headers stub — enforced at edge / server level -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">
      {t(locale, "aria.skipToContent")}
    </a>

    {
      showHeader && (
        <Header
          currentLocale={locale}
          currentPath={path}
          showThemeToggle={showThemeToggle}
          showBrand={showHeaderBrand}
          monochrome={monochromeHeader}
          deferBrandLoading={deferPageResources}
        />
      )
    }

    <SearchModal locale={locale} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {Astro.slots.has("analytics") ? <slot name="analytics" /> : <Analytics />}

    {
      showFooter && (
        <Footer deferBrandLoading={deferPageResources} />
      )
    }

    <script
      is:inline
      define:vars={{
        gatePrimaryFonts: preloadPrimaryFonts && !deferPageResources,
      }}
    >
      if (gatePrimaryFonts) {
        (() => {
          const root = document.documentElement;
          if (!document.fonts) {
            root.dataset.fontGate = "ready";
            return;
          }

          const visibleFonts = new Map();
          const walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
          );
          const range = document.createRange();
          const inViewport = (rect) =>
            rect.bottom > 0 &&
            rect.top < window.innerHeight &&
            rect.right > 0 &&
            rect.left < window.innerWidth;

          const addFont = (family, style, text) => {
            const font = `${style.fontStyle} ${style.fontWeight} 16px "${family}"`;
            visibleFonts.set(font, (visibleFonts.get(font) || "") + text);
          };

          while (walker.nextNode()) {
            const node = walker.currentNode;
            const element = node.parentElement;
            const text = node.textContent?.trim();
            if (
              !element ||
              !text ||
              element.closest("script, style, noscript")
            ) {
              continue;
            }

            range.selectNodeContents(node);
            if (!Array.from(range.getClientRects()).some(inViewport)) continue;

            const style = window.getComputedStyle(element);
            if (style.visibility !== "visible" || style.opacity === "0") {
              continue;
            }

            if (/[\u2e80-\u9fff\u3000-\u303f\uff00-\uffef]/u.test(text)) {
              if (style.fontFamily.includes("Noto Serif SC")) {
                addFont("Noto Serif SC", style, text);
              } else if (style.fontFamily.includes("Noto Sans SC")) {
                addFont("Noto Sans SC", style, text);
              }
            }

            if (style.fontFamily.startsWith('"Anthropic Serif"')) {
              addFont("Anthropic Serif", style, text);
            } else if (style.fontFamily.startsWith('"Anthropic Sans"')) {
              addFont("Anthropic Sans", style, text);
            } else if (style.fontFamily.includes("JetBrains Mono Variable")) {
              addFont("JetBrains Mono Variable", style, text);
            }
          }

          Promise.allSettled(
            Array.from(visibleFonts, ([font, text]) =>
              document.fonts.load(font, text),
            ),
          ).then(() => {
            root.dataset.fontGate = "ready";
          });
        })();
      }
    </script>
  </body>
</html>
