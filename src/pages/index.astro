---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/Hero.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { ActivityPulse } from "../components/landing/ActivityPulse";
import RecentPosts from "../components/landing/RecentPosts.astro";
import RecentDaily from "../components/landing/RecentDaily.astro";
import { t } from "../i18n/ui";
import heroAsciiLandscape from "../assets/images/hero-ascii-landscape.webp";

// Calculate Activity Pulse data for the last 365 days
const allPosts = (await getCollection("blog")) as CollectionEntry<"blog">[];
const allDaily = (await getCollection("daily")) as CollectionEntry<"daily">[];

const today = new Date();
const past365Days = new Date(today.getTime() - 365 * 24 * 60 * 60 * 1000);

const dateMap = new Map();
// Pre-fill the last 365 days to ensure empty days are represented
for (let i = 0; i < 365; i++) {
  const d = new Date(past365Days.getTime() + i * 24 * 60 * 60 * 1000);
  const dateString = d.toISOString().split("T")[0];
  dateMap.set(dateString, { date: dateString, posts: 0, daily: 0 });
}

allPosts.forEach((post) => {
  const dateString = new Date(post.data.publishDate)
    .toISOString()
    .split("T")[0];
  if (dateMap.has(dateString)) {
    dateMap.get(dateString).posts += 1;
  }
});

allDaily.forEach((daily) => {
  const dateString = new Date(daily.data.publishDate)
    .toISOString()
    .split("T")[0];
  if (dateMap.has(dateString)) {
    dateMap.get(dateString).daily += 1;
  }
});

const activityData = Array.from(dateMap.values());

// Get top 5 recent posts and daily
const recentPosts = allPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const recentDaily = allDaily
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const locale = "zh-CN" as const;
---

<MarketingLayout
  title={t(locale, "nav.home")}
  description="zHysie - 永远对世界保持好奇"
  locale={locale}
  path="/"
  deferPageResources={true}
>
  <Hero
    extendBehindHeader={true}
    fullViewport={true}
    variant="centered"
    size="xl"
    headline="只要不失去你的崇高，整个世界都会向你敞开"
    animatedHeadlineText="只要不失去你的崇高，整个世界都会向你敞开"
    mobileHeadlineBreakAfter="，"
    scrollZoom={true}
    footerText="永远对世界保持好奇"
    scrollTarget="home-content"
    scrollLabel="Scroll to the next section"
    locale={locale}
    asciiBackground={heroAsciiLandscape}
    asciiEntrance="ripple"
  >
    <span
      slot="eyebrow"
      class="welcome-intro"
      aria-label="Hi there, I'm zHysie."
    >
      <span aria-hidden="true">Hi there, I'm</span>
      <span class="welcome-intro__brand" aria-hidden="true">
        <img
          class="welcome-intro__logo welcome-intro__logo--light"
          data-home-src="/logos/zHysie_logo.svg"
          alt=""
          width="1959"
          height="1050"
        />
        <img
          class="welcome-intro__logo welcome-intro__logo--dark"
          data-home-src="/logos/zHysie_logo-dark.svg"
          alt=""
          width="1959"
          height="1050"
        />
      </span>
    </span>
  </Hero>

  <section id="home-content" class="container py-10" data-home-deferred>
    <div class="home-grid">
      <div class="home-grid__main">
        <RecentPosts posts={recentPosts} locale={locale} />
      </div>
      <div class="home-grid__side">
        <RecentDaily daily={recentDaily} locale={locale} />
      </div>
    </div>
  </section>

  <section class="container pb-24" data-home-deferred>
    <ActivityPulse client:hero-ready data={activityData} />
  </section>
</MarketingLayout>

<script>
  const connectHomeResourceGate = () => {
    const hero = document.querySelector<HTMLElement>(
      '[data-ascii-entrance="ripple"]',
    );
    if (!hero || hero.dataset.homeResourceGate === "connected") return;

    hero.dataset.homeResourceGate = "connected";
    const release = () =>
      window.dispatchEvent(new CustomEvent("home-resources-release"));

    if (hero.dataset.asciiEntranceState === "complete") {
      release();
      return;
    }

    hero.addEventListener("hero-ascii-ready", release, { once: true });
    window.requestAnimationFrame(() => {
      if (hero.dataset.asciiEntranceState === "complete") release();
    });
  };

  connectHomeResourceGate();
  document.addEventListener("astro:page-load", connectHomeResourceGate);
</script>

<style>
  :global(html[data-home-resource-state="waiting"] [data-header]),
  :global(html[data-home-resource-state="loading"] [data-header]),
  :global(html[data-home-resource-state="waiting"] .hero__eyebrow),
  :global(html[data-home-resource-state="loading"] .hero__eyebrow),
  :global(html[data-home-resource-state="waiting"] .hero__headline),
  :global(html[data-home-resource-state="loading"] .hero__headline),
  :global(html[data-home-resource-state="waiting"] .hero__footer),
  :global(html[data-home-resource-state="loading"] .hero__footer),
  :global(html[data-home-resource-state="waiting"] [data-home-deferred]),
  :global(html[data-home-resource-state="loading"] [data-home-deferred]),
  :global(html[data-home-resource-state="waiting"] .footer),
  :global(html[data-home-resource-state="loading"] .footer) {
    visibility: hidden;
    pointer-events: none;
  }

  :global(html[data-home-resource-state="waiting"] [data-header]),
  :global(html[data-home-resource-state="loading"] [data-header]),
  :global(html[data-home-resource-state="waiting"] .hero__eyebrow),
  :global(html[data-home-resource-state="loading"] .hero__eyebrow),
  :global(html[data-home-resource-state="waiting"] .hero__headline),
  :global(html[data-home-resource-state="loading"] .hero__headline),
  :global(html[data-home-resource-state="waiting"] .hero__footer),
  :global(html[data-home-resource-state="loading"] .hero__footer) {
    opacity: 0;
  }

  :global(html[data-home-resource-state="waiting"] [data-header]),
  :global(html[data-home-resource-state="loading"] [data-header]) {
    translate: 0 -0.5rem;
  }

  :global(html[data-home-resource-state="waiting"] .hero__eyebrow),
  :global(html[data-home-resource-state="loading"] .hero__eyebrow),
  :global(html[data-home-resource-state="waiting"] .hero__headline),
  :global(html[data-home-resource-state="loading"] .hero__headline),
  :global(html[data-home-resource-state="waiting"] .hero__footer),
  :global(html[data-home-resource-state="loading"] .hero__footer) {
    translate: 0 0.5rem;
  }

  :global(html[data-home-resource-state="revealing"] [data-header]) {
    animation: home-reveal-from-above 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(html[data-home-resource-state="revealing"] .hero__eyebrow) {
    animation: home-reveal-from-below 600ms cubic-bezier(0.16, 1, 0.3, 1) 80ms
      both;
  }

  :global(html[data-home-resource-state="revealing"] .hero__headline) {
    animation: home-reveal-from-below 650ms cubic-bezier(0.16, 1, 0.3, 1) 160ms
      both;
  }

  :global(html[data-home-resource-state="revealing"] .hero__footer) {
    animation: home-reveal-from-below 550ms cubic-bezier(0.16, 1, 0.3, 1) 260ms
      both;
  }

  :global(html[data-home-resource-state="revealing"] [data-header]),
  :global(html[data-home-resource-state="revealing"] .hero__eyebrow),
  :global(html[data-home-resource-state="revealing"] .hero__headline),
  :global(html[data-home-resource-state="revealing"] .hero__footer) {
    visibility: visible;
    pointer-events: auto;
    will-change: opacity, translate;
  }

  @keyframes home-reveal-from-above {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes home-reveal-from-below {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .welcome-intro {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    white-space: nowrap;
  }

  .welcome-intro__brand {
    display: inline-grid;
    width: auto;
    height: 1.2em;
    aspect-ratio: 1959 / 1050;
    flex: 0 0 auto;
    transform: translateY(0.04em);
  }

  .welcome-intro__logo {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .welcome-intro__logo--dark {
    display: none;
  }

  :global(html.dark) .welcome-intro__logo--light {
    display: none;
  }

  :global(html.dark) .welcome-intro__logo--dark {
    display: block;
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
  }

  .home-grid > * {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-home-resource-state="revealing"] [data-header]),
    :global(html[data-home-resource-state="revealing"] .hero__eyebrow),
    :global(html[data-home-resource-state="revealing"] .hero__headline),
    :global(html[data-home-resource-state="revealing"] .hero__footer) {
      opacity: 1;
      animation: none;
      translate: 0 0;
      will-change: auto;
    }
  }
</style>
