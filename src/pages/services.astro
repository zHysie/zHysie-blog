---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { t } from "../i18n/ui";
import Hero from "../components/Hero.astro";
import { ServiceCard } from "../components/services/index";

const locale = "zh-CN" as const;

const allServices: CollectionEntry<"services">[] =
  await getCollection("services");
const services = allServices
  .filter((s) => s.data.locale === locale)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={t(locale, "nav.services")}
  description="围绕内容型网站开发与静态发布整理的实践方向。"
  locale={locale}
  path={"/services"}
>
  <Hero
    variant="centered"
    size="md"
    eyebrow="实践方向"
    title="从真实问题开始"
    content="这里展示正在积累的内容型网站与静态发布实践，不虚构团队、套餐或交付履历。"
    locale={locale}
  />

  <section class="services-list container">
    {
      services.length === 0 && (
        <p class="services-list__empty">内容仍在整理中。</p>
      )
    }
    <div class="services-list__grid">
      {
        services.map((service) => (
          <ServiceCard service={service} locale={locale} headingLevel="h2" />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .services-list {
    padding-block: var(--space-xl) var(--space-3xl);
  }
  .services-list__empty {
    padding: var(--space-3xl) var(--space-lg);
    text-align: center;
    color: var(--color-text-secondary);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-2xl);
  }
  .services-list__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    max-width: 60rem;
    margin-inline: auto;
  }
</style>
