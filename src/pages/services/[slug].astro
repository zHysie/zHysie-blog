---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import CTA from "../../components/CTA.astro";

export async function getStaticPaths() {
  const allServices: CollectionEntry<"services">[] =
    await getCollection("services");
  return allServices
    .filter((service) => service.data.locale === "zh-CN")
    .map((service) => ({
      params: { slug: service.data.slug },
      props: { service, locale: service.data.locale },
    }));
}

const { service, locale } = Astro.props as {
  service: CollectionEntry<"services">;
  locale: "zh-CN";
};
const { Content, headings } = await render(service);
---

<ServiceLayout service={service} locale={locale} headings={headings}>
  <Content />
  <CTA
    slot="cta"
    title="想讨论一个具体问题？"
    content="可以先说明目标、现有代码与期望范围，再判断是否适合一起处理。"
    ctaText="联系我"
    ctaHref="/contact"
    locale={locale}
  />
</ServiceLayout>
