---
import { getCollection, type CollectionEntry } from "astro:content";
import { TimelineArchive } from "../components/sections";
import { t } from "../i18n/ui";
import { resolveRoute } from "../i18n/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/site-config";
import { buildTimelineItems } from "../lib/timeline";

const locale = "zh-CN" as Locale;
const [posts, daily] = (await Promise.all([
  getCollection("blog"),
  getCollection("daily"),
])) as [CollectionEntry<"blog">[], CollectionEntry<"daily">[]];
const items = buildTimelineItems(posts, daily, locale);
---

<BaseLayout
  title={t(locale, "timeline.title")}
  description={t(locale, "timeline.lead")}
  locale={locale}
  path={resolveRoute(locale, "/timeline")}
  showHeader={false}
  showFooter={false}
  preloadPrimaryFonts={true}
>
  <TimelineArchive items={items} locale={locale} />
</BaseLayout>
